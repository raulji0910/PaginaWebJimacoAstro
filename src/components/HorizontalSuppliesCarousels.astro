---
import { PRODUCTS as CATALOG } from '../data/products';
import { PRODUCTS as STORE } from '../data/store';

// Carrusel solar: fotos reales de obra + productos del catálogo y la tienda para energía solar
const solarPhotos = [
  { img: '/images/entregas/placas-tendido-parque-solar.jpg', title: 'Placas de protección en parque solar' },
  { img: '/images/entregas/tramos-descarga-camion.jpg', title: 'Descarga de tubería PEAD HDPE' },
  { img: '/images/entregas/placas-instalacion-zanja.jpg', title: 'Instalación de placas en zanja' },
  { img: '/images/entregas/entrega-contenedor-2.jpg', title: 'Despacho de tubería en contenedor' }
];
const solarCatalogIds = [
  'cable-fotovoltaico', 'cable-xlpe', 'cable-de-cobre-desnudo', 'terminal-de-ojo', 'terminal-cable-aislado',
  'varilla-cooper', 'conector-varilla', 'caja-puesta-a-tierra-material-plastico', 'tuberia-conduit',
  'accesorios-tuberia', 'reflector-solar', 'lampara-led-con-panel-solar', 'advertencia-fuente-de-potencia-fotovoltaica'
];
const solarProducts = [
  ...STORE.filter((p) => p.category === 'energia-solar').map((p) => ({ img: p.image, title: p.name, href: '/tienda' })),
  ...solarCatalogIds
    .map((id) => CATALOG.find((p) => p.id === id))
    .filter(Boolean)
    .map((p) => ({ img: p!.image, title: p!.name, href: `/catalogo#info=${p!.id}` }))
];

// Carrusel de construcción: todos los productos del Catálogo de productos
const constProducts = CATALOG.map((p) => ({ id: p.id, img: p.image, title: p.name }));

// Carrusel de protección personal: sección "Dotación industrial y seguridad" del Catálogo
const eppProducts = CATALOG
  .filter((p) => p.group === 'Dotación industrial y seguridad')
  .map((p) => ({ id: p.id, img: p.image, title: p.name }));
---

<div class="space-y-12 pb-16 bg-white overflow-hidden">
  
  <!-- CAROUSEL 1: CONSTRUCCIÓN (Screenshot 2: Green Box) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-[40px] relative group">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-0 items-stretch bg-gray-50 border border-gray-200 rounded-2xl overflow-hidden">
      
      <!-- Left Carousel Images -->
      <div class="lg:col-span-8 overflow-hidden relative p-4 flex items-center">
        <button class="carousel-prev-btn absolute left-4 z-20 w-10 h-10 rounded-full bg-white/90 text-[#134716] shadow-lg flex items-center justify-center hover:bg-[#134716] hover:text-white transition-all">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
        </button>

        <div class="carousel-track track-green flex gap-4 overflow-x-auto scroll-smooth pt-2 pb-4 w-full">
          {constProducts.map((p) => (
            <a
              href={`/catalogo#info=${p.id}`}
              class="shrink-0 w-56 sm:w-60 h-72 sm:h-80 rounded-xl overflow-hidden shadow-md relative bg-white border border-gray-100 group/card flex flex-col"
            >
              <div class="flex-1 flex items-center justify-center p-4 bg-white">
                <img src={p.img} alt={p.title} loading="lazy" class="max-h-full w-auto object-contain group-hover/card:scale-105 transition-transform duration-500" draggable="false" />
              </div>
              <p class="px-4 py-3 border-t border-gray-100 text-[#0B1E02] font-display font-bold text-sm leading-snug line-clamp-2 group-hover/card:text-[#1C6521] transition-colors">
                {p.title}
              </p>
            </a>
          ))}
        </div>

        <button class="carousel-next-btn absolute right-4 z-20 w-10 h-10 rounded-full bg-white/90 text-[#134716] shadow-lg flex items-center justify-center hover:bg-[#134716] hover:text-white transition-all">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>

      <!-- Right Feature Card (Forest Green #0D4E1F) -->
      <div class="lg:col-span-4 bg-[#0D4E1F] text-white p-8 sm:p-12 flex flex-col justify-between space-y-6 relative overflow-hidden">
        <!-- Background watermark -->
        <div class="absolute right-0 bottom-0 opacity-10 pointer-events-none">
          <svg class="w-64 h-64" viewBox="0 0 24 24" fill="currentColor"><path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
        </div>

        <div class="space-y-4 relative z-10">
