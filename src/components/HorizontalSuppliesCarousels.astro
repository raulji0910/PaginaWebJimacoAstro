          ))}
        </div>

        <button class="carousel-next-btn absolute right-4 z-20 w-10 h-10 rounded-full bg-white/90 text-[#FFCE38] shadow-lg flex items-center justify-center hover:bg-[#FFCE38] hover:text-[#0B1E02] transition-all">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
        </button>
