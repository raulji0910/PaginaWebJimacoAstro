</div>

<style>
  .carousel-track {
    --thumb: #1C6521;
    --rail: rgba(11, 30, 2, 0.08);
    scroll-snap-type: x proximity;
  }
  .track-green { --thumb: #1C6521; --rail: rgba(28, 101, 33, 0.12); }
  .track-amber { --thumb: #0B1E02; --rail: rgba(11, 30, 2, 0.12); }
  .track-neon  { --thumb: #7BBE6F; --rail: rgba(255, 255, 255, 0.12); }

  .carousel-track::-webkit-scrollbar { height: 8px; }
  .carousel-track::-webkit-scrollbar-track {
    background: var(--rail);
    border-radius: 999px;
    margin: 0 12px;
  }
  .carousel-track::-webkit-scrollbar-thumb {
    background: var(--thumb);
    border-radius: 999px;
    border: 0;
    transition: background 0.2s;
  }
  .carousel-track::-webkit-scrollbar-thumb:hover { background: #FF6A1C; }
  .carousel-track::-webkit-scrollbar-button { display: none; width: 0; height: 0; }
  .carousel-track > * { scroll-snap-align: start; }
  /* Firefox */
  @supports not selector(::-webkit-scrollbar) {
    .carousel-track { scrollbar-width: thin; scrollbar-color: var(--thumb) var(--rail); }
  }
</style>

<script>
  function setupScrollButtons() {
    const tracks = document.querySelectorAll('.carousel-track');
    tracks.forEach((track) => {
      const parent = track.parentElement;
      const prev = parent.querySelector('.carousel-prev-btn');
      const next = parent.querySelector('.carousel-next-btn');

      if (prev) {
        prev.onclick = () => { track.scrollBy({ left: -320, behavior: 'smooth' }); };
      }
      if (next) {
        next.onclick = () => { track.scrollBy({ left: 320, behavior: 'smooth' }); };
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupScrollButtons);
  document.addEventListener('astro:after-swap', setupScrollButtons);
</script>
