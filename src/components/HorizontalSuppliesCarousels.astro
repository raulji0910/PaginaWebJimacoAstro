<script>
  function setupScrollButtons() {
    const tracks = document.querySelectorAll('.carousel-track');
    tracks.forEach((track) => {
      const parent = track.parentElement;
      const prev = parent.querySelector('.carousel-prev-btn');
      const next = parent.querySelector('.carousel-next-btn');

      if (prev) {
        prev.onclick = () => { track.scrollBy({ left: -320, behavior: 'smooth' }); };
      }
      if (next) {
        next.onclick = () => { track.scrollBy({ left: 320, behavior: 'smooth' }); };
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupScrollButtons);
  document.addEventListener('astro:after-swap', setupScrollButtons);
</script>
