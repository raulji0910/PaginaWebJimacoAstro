        </div>
      </div>

    </div>
  </div>

  <!-- CAROUSEL 2: PROTECCIÓN PERSONAL EPP (Screenshot 3: Yellow Box) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-[40px] relative group">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-0 items-stretch bg-[#FFFDF0] border border-amber-200 rounded-2xl overflow-hidden">
      
      <!-- Left Feature Card (Golden Yellow #FFCE38) -->
      <div class="lg:col-span-4 bg-[#FFCE38] text-[#0B1E02] p-8 sm:p-12 flex flex-col justify-between space-y-6 relative overflow-hidden">
        <!-- Background watermark helmet -->
        <div class="absolute -right-6 -bottom-6 opacity-15 pointer-events-none">
          <svg class="w-64 h-64" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/></svg>
