  </div>

  <!-- CAROUSEL 3: SOLAR (Dark Green Box) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-[40px] relative group">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-0 items-stretch bg-emerald-950 border border-emerald-900 rounded-2xl overflow-hidden">
      
      <!-- Left Carousel Images -->
      <div class="lg:col-span-8 overflow-hidden relative p-4 flex items-center">
        <button class="carousel-prev-btn absolute left-4 z-20 w-10 h-10 rounded-full bg-white/90 text-[#0B1E02] shadow-lg flex items-center justify-center hover:bg-[#1C6521] hover:text-white transition-all">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
        </button>

        <div class="carousel-track track-neon flex gap-4 overflow-x-auto scroll-smooth pt-2 pb-4 w-full">
          {solarPhotos.map((p) => (
            <div class="shrink-0 w-64 sm:w-72 h-80 sm:h-96 rounded-xl overflow-hidden shadow-md relative bg-white border border-gray-100 group/card">
              <img src={p.img} alt={p.title} loading="lazy" class="w-full h-full object-cover group-hover/card:scale-105 transition-transform duration-500" draggable="false" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
              <p class="absolute bottom-4 left-4 right-4 text-white font-display font-bold text-sm leading-snug">{p.title}</p>
            </div>
          ))}
          {solarProducts.map((p) => (
            <a
              href={p.href}
              class="shrink-0 w-56 sm:w-60 h-80 sm:h-96 rounded-xl overflow-hidden shadow-md relative bg-white border border-gray-100 group/card flex flex-col"
            >
              <div class="flex-1 min-h-0 flex items-center justify-center p-4 bg-white">
                <img src={p.img} alt={p.title} loading="lazy" class="max-h-full w-auto object-contain group-hover/card:scale-105 transition-transform duration-500" draggable="false" />
              </div>
              <p class="px-4 py-3 border-t border-gray-100 text-[#0B1E02] font-display font-bold text-sm leading-snug line-clamp-2 group-hover/card:text-[#1C6521] transition-colors">{p.title}</p>
            </a>
          ))}
        </div>

        <button class="carousel-next-btn absolute right-4 z-20 w-10 h-10 rounded-full bg-white/90 text-[#0B1E02] shadow-lg flex items-center justify-center hover:bg-[#1C6521] hover:text-white transition-all">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>

      <!-- Right Feature Card (Dark Green) -->
      <div class="lg:col-span-4 bg-[#0A2610] text-white p-8 sm:p-12 flex flex-col justify-between space-y-6 relative overflow-hidden">
        <div class="space-y-4 relative z-10">
          <h3 class="font-display text-3xl sm:text-4xl font-extrabold leading-tight">
            ¿Tienes un proyecto de granja solar?
          </h3>
          <p class="text-emerald-100 text-sm leading-relaxed">
            <strong class="text-white font-bold">Ofrecemos suministros de calidad para el sector energético.</strong> Como importadores directos en Colombia, en JIMACO entregamos suministros certificados, garantizando rendimiento, seguridad y soporte técnico para proyectos fotovoltaicos.
          </p>
        </div>

        <div class="relative z-10 pt-4">
          <a
            href="https://wa.me/573123503397?text=Hola%20JIMACO,%20deseo%20cotizar%20suministros%20para%20un%20proyecto%20solar"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 border border-white/60 hover:bg-white hover:text-[#0A2610] text-white px-6 py-2.5 rounded-md font-display font-bold uppercase text-xs tracking-wider transition-all"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
            <span>Escríbenos</span>
