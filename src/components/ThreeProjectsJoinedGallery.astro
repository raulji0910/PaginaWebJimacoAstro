---
const gallery = [
  { img: '/images/granja-solar.jpg', alt: 'Parque de Energía Solar Fotovoltaica' },
  { img: '/images/trabajadores-en-construccion.jpg', alt: 'Ingenieros y Operarios en Obra Civil' },
  { img: '/images/tuberia-metalica-galvanizada.jpg', alt: 'Suministro de Tubería Metálica Galvanizada' }
];
---

<section class="w-full bg-white py-6 sm:py-10 overflow-hidden">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
      {gallery.map((item) => (
        <div class="rounded-2xl overflow-hidden shadow-md hover:shadow-2xl border border-gray-100 bg-gray-100 group transition-all duration-500 transform hover:-translate-y-1.5">
          <img
            src={item.img}
            alt={item.alt}
            class="w-full h-64 sm:h-80 lg:h-96 object-cover object-center group-hover:scale-106 transition-transform duration-700"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>
</section>
