---
---
<footer class="bg-[#0D2614] text-white pt-16 pb-12 border-t border-emerald-900/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
    <!-- Brand Info -->
    <div class="space-y-4">
      <img src="/images/logo-horizontal.png" alt="JIMACO" class="h-10 w-auto brightness-0 invert opacity-90" />
      <p class="text-sm text-emerald-100/70 leading-relaxed">
        Más de una década acompañando al sector industrial, energético y de construcción en Colombia con soluciones técnicas certificadas y respaldo confiable.
      </p>
      <div class="pt-2">
        <span class="inline-block bg-emerald-800/60 text-jimaco-accent text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider">
          ISO 9001:2015 en gestión de calidad
        </span>
      </div>
    </div>

    <!-- Quick Links -->
    <div>
      <h3 class="font-display text-lg font-bold text-white uppercase tracking-wider mb-4 border-b border-emerald-800/60 pb-2">Empresa</h3>
      <ul class="space-y-2.5 text-sm text-emerald-100/80">
        <li><a href="/sobre-jimaco" class="hover:text-jimaco-accent transition-colors">Quiénes Somos</a></li>
        <li><a href="/politica-de-calidad" class="hover:text-jimaco-accent transition-colors font-medium text-emerald-300">Política de Calidad y Objetivos</a></li>
        <li><a href="/suministros" class="hover:text-jimaco-accent transition-colors">Líneas de Suministros</a></li>
        <li><a href="/ponte-en-contacto" class="hover:text-jimaco-accent transition-colors">Sede y Canales de Atención</a></li>
      </ul>
    </div>

    <!-- Lines of Supply -->
    <div>
      <h3 class="font-display text-lg font-bold text-white uppercase tracking-wider mb-4 border-b border-emerald-800/60 pb-2">Suministros</h3>
      <ul class="space-y-2.5 text-sm text-emerald-100/80">
        <li><a href="/suministros-de-energia-solar" class="hover:text-jimaco-accent transition-colors">Energías Renovables</a></li>
        <li><a href="/suministros-para-construccion" class="hover:text-jimaco-accent transition-colors">Materiales e Insumos de Construcción</a></li>
        <li><a href="/suministros-para-proteccion-personal" class="hover:text-jimaco-accent transition-colors">Protección Personal</a></li>
        <li><a href="/suministros" class="hover:text-jimaco-accent transition-colors">Tubería Galvanizada y PEAD</a></li>
      </ul>
    </div>

    <!-- Contact Info -->
    <div>
      <h3 class="font-display text-lg font-bold text-white uppercase tracking-wider mb-4 border-b border-emerald-800/60 pb-2">Contacto</h3>
      <ul class="space-y-3 text-sm text-emerald-100/80">
        <li class="flex items-start gap-2.5">
          <svg class="w-5 h-5 text-jimaco-orange shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span>Cl. 23 #25-06, Samper Mendoza, Bogotá, Colombia</span>
        </li>
        <li class="flex items-center gap-2.5">
          <svg class="w-5 h-5 text-jimaco-orange shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <a href="tel:+573123503397" class="hover:text-white">+57 312 3503397 / 315 8964700</a>
        </li>
        <li class="flex items-center gap-2.5">
          <svg class="w-5 h-5 text-jimaco-orange shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <a href="mailto:ventas@jimaco.com.co" class="hover:text-white">ventas@jimaco.com.co</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-8 mt-12 pt-6 border-t border-emerald-900/60 flex flex-col sm:flex-row justify-between items-center text-xs text-emerald-100/50 gap-4">
    <p>© {new Date().getFullYear()} FERRETERÍA INDUSTRIAL JIMACO S.A.S. — Todos los derechos reservados.</p>
    <div class="flex space-x-6">
      <a href="/politica-de-calidad" class="hover:text-white transition-colors">Política de Calidad</a>
      <a href="/ponte-en-contacto" class="hover:text-white transition-colors">Términos y Contacto</a>
    </div>
  </div>
</footer>
