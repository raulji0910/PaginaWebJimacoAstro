---
const projects = [
  {
    name: 'Granja Solar Celsia - Flandes, Tolima',
    location: 'Flandes, Tolima',
    desc: 'Suministro de placas de protección subterránea, cable fotovoltaico y tubería para canalización a gran escala.',
    image: '/images/Granja-Solar-Celsia-Flandes-Tolima.jpg'
  },
  {
    name: 'Granja Solar Celsia - Dulima',
    location: 'Ibagué, Tolima',
    desc: 'Materiales certificados y accesorios para sistema de puesta a tierra y protección integral.',
    image: '/images/Granja-Solar-Celsia-Dulima.jpg'
  },
  {
    name: 'Granja Solar Celsia - Yuma',
    location: 'Tolima, Colombia',
    desc: 'Suministro técnico oportuno garantizando cumplimiento en los tiempos críticos de construcción.',
    image: '/images/Granja-Solar-Celsia-Yuma.jpg'
  }
];
---

<section class="py-20 bg-[#0B1E02] text-white relative overflow-hidden">
  <!-- Background texture -->
  <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#7BBE6F_1px,transparent_1px)] [background-size:16px_16px]"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
      <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-jimaco-accent font-display">
        Llegando Lejos
      </span>
      <h2 class="font-display text-3xl sm:text-5xl font-extrabold text-white">
        En los proyectos <span class="text-jimaco-accent">más destacados</span>
      </h2>
      <p class="text-emerald-100/70 text-sm sm:text-base">
        Acompañamos a los grandes generadores de energía y constructoras de Colombia con suministros confiables y trazabilidad total.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {projects.map((proj) => (
        <div class="bg-white/5 backdrop-blur-md rounded-2xl overflow-hidden border border-white/10 shadow-2xl flex flex-col group hover:border-emerald-500/40 transition-all duration-300">
          <div class="h-60 overflow-hidden relative">
            <img src={proj.image} alt={proj.name} class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0B1E02] via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-4 bg-jimaco-orange text-white text-xs font-bold px-3 py-1 rounded-md uppercase">
              {proj.location}
            </span>
          </div>
          <div class="p-6 flex-grow flex flex-col justify-between space-y-3">
            <h3 class="font-display font-bold text-xl text-white group-hover:text-jimaco-accent transition-colors">
              {proj.name}
            </h3>
            <p class="text-xs text-emerald-100/70 leading-relaxed">
              {proj.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
