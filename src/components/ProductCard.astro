---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;

const priceLabel = product.price
  ? new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(product.price)
  : null;
---

<div
  class="product-card group bg-white rounded-2xl border border-gray-200/80 hover:border-jimaco-primary/50 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between overflow-hidden relative"
  data-id={product.id}
  data-name={product.name.toLowerCase()}
  data-reference={(product.reference || '').toLowerCase()}
  data-brand={(product.brand || '').toLowerCase()}
  data-category={product.category}
  data-text={`${product.name} ${product.categoryName} ${product.description}`.toLowerCase()}
>
  <!-- Imagen del producto -->
  <button
    type="button"
    class="view-info-btn p-5 bg-white flex items-center justify-center relative overflow-hidden aspect-4/3 cursor-pointer"
    data-id={product.id}
    aria-label={`Ver información de ${product.name}`}
  >
    <img
      src={product.image}
      alt={product.name}
      class="max-h-44 w-auto object-contain transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
  </button>

  <!-- Contenido -->
  <div class="p-4 sm:p-5 flex-1 flex flex-col justify-between border-t border-gray-100">
    <div>
      <div class="flex items-center justify-between gap-2 text-[11px] mb-1.5">
        <span class="font-extrabold uppercase tracking-wider text-jimaco-primary font-display line-clamp-1">
          {product.categoryName}
        </span>
        {product.reference && (
          <span class="font-mono text-gray-500 text-[10px] shrink-0">Ref. {product.reference}</span>
        )}
      </div>

      <h3 class="text-sm font-bold font-sans text-gray-900 group-hover:text-jimaco-primary transition-colors line-clamp-2 leading-snug mb-2" title={product.name}>
        {product.name}
      </h3>

      <p class="text-xs text-gray-600 leading-relaxed line-clamp-3 mb-3">
        {product.description}
      </p>

      {priceLabel && (
        <div class="mb-4 pt-2 border-t border-gray-100/80">
          <div class="text-xl font-extrabold text-jimaco-dark font-display">{priceLabel}</div>
          <p class="text-[10px] text-emerald-700 font-semibold">IVA incluido</p>
        </div>
      )}
    </div>

    <!-- Botones de acción -->
    <div class="grid grid-cols-2 gap-2">
      <button
        type="button"
        class="view-info-btn border-2 border-jimaco-primary/30 hover:border-jimaco-primary text-jimaco-primary hover:bg-emerald-50 font-display font-bold uppercase tracking-wider text-[11px] py-2.5 px-2 rounded-xl transition-all cursor-pointer"
        data-id={product.id}
      >
        Ver información
      </button>
      <button
        type="button"
        class="request-quote-btn bg-jimaco-orange hover:bg-jimaco-orangeHover text-white font-display font-bold uppercase tracking-wider text-[11px] py-2.5 px-2 rounded-xl shadow-xs hover:shadow-md transition-all cursor-pointer"
        data-id={product.id}
      >
        Solicitar cotización
      </button>
    </div>
  </div>
</div>
