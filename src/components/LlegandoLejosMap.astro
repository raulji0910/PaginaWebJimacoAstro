---
---
<section class="py-20 sm:py-24 bg-[#0A1E0D] text-white relative overflow-hidden">
  <!-- Subtle ambient green glow in background -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-emerald-600/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10 space-y-12">
    
    <!-- Top Header: LLEGANDO LEJOS with Horizontal Line -->
    <div class="flex items-center gap-6">
      <span class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-[#7BBE6F] font-display whitespace-nowrap">
        LLEGANDO LEJOS
      </span>
      <div class="h-[1px] bg-white/20 flex-1"></div>
    </div>

    <!-- Main Grid: Left Metric, Center Map with Pins, Right Headline -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left: Big Number Counter -->
      <div class="lg:col-span-4 flex items-baseline gap-4 sm:gap-6">
        <span class="font-display text-6xl sm:text-7xl lg:text-8xl font-black text-[#88D67C] tracking-tight leading-none">
          +460
        </span>
        <div class="space-y-1">
          <p class="font-display font-bold uppercase text-xs sm:text-sm tracking-wider text-white">
            Clientes
          </p>
          <p class="font-display font-medium text-xs sm:text-sm text-emerald-200/80">
            satisfechos
          </p>
        </div>
      </div>

      <!-- Center: Map of Colombia with Pulsing Location Pins -->
      <div class="lg:col-span-4 relative flex justify-center py-4">
        <div class="relative w-full max-w-[320px] sm:max-w-[380px]">
          <img
            src="/images/map-colombia.png"
            alt="Mapa de Cobertura en Colombia JIMACO"
            class="w-full h-auto object-contain filter drop-shadow-[0_10px_25px_rgba(0,0,0,0.5)] opacity-90"
          />

          <!-- Pulsing Pin 1: Costa / Barranquilla / Guajira -->
          <div class="absolute top-[16%] left-[44%] -translate-x-1/2 -translate-y-1/2 group cursor-pointer">
            <span class="relative flex h-5 w-5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-5 w-5 bg-white/30 border-2 border-emerald-400 items-center justify-center">
                <span class="h-1.5 w-1.5 rounded-full bg-[#88D67C]"></span>
              </span>
            </span>
          </div>

          <!-- Pulsing Pin 2: Antioquia / Medellín -->
          <div class="absolute top-[38%] left-[36%] -translate-x-1/2 -translate-y-1/2 group cursor-pointer">
            <span class="relative flex h-5 w-5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-5 w-5 bg-white/30 border-2 border-emerald-400 items-center justify-center">
                <span class="h-1.5 w-1.5 rounded-full bg-[#88D67C]"></span>
              </span>
            </span>
          </div>

          <!-- Pulsing Pin 3: Bogotá / Cundinamarca (Sede Principal) -->
          <div class="absolute top-[52%] left-[45%] -translate-x-1/2 -translate-y-1/2 group cursor-pointer">
            <span class="relative flex h-6 w-6">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-90"></span>
              <span class="relative inline-flex rounded-full h-6 w-6 bg-jimaco-orange/40 border-2 border-orange-400 items-center justify-center">
                <span class="h-2 w-2 rounded-full bg-jimaco-orange"></span>
              </span>
            </span>
          </div>

          <!-- Pulsing Pin 4: Llanos Orientales / Casanare / Meta -->
          <div class="absolute top-[48%] left-[62%] -translate-x-1/2 -translate-y-1/2 group cursor-pointer">
            <span class="relative flex h-5 w-5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-5 w-5 bg-white/30 border-2 border-emerald-400 items-center justify-center">
                <span class="h-1.5 w-1.5 rounded-full bg-[#88D67C]"></span>
              </span>
            </span>
          </div>

          <!-- Pulsing Pin 5: Suroccidente / Valle / Cali -->
          <div class="absolute top-[60%] left-[32%] -translate-x-1/2 -translate-y-1/2 group cursor-pointer">
            <span class="relative flex h-5 w-5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-5 w-5 bg-white/30 border-2 border-emerald-400 items-center justify-center">
                <span class="h-1.5 w-1.5 rounded-full bg-[#88D67C]"></span>
              </span>
            </span>
          </div>

        </div>
      </div>

      <!-- Right: Headline Copy -->
      <div class="lg:col-span-4 lg:pl-6 space-y-4">
        <h3 class="font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white leading-tight">
          Más de una década impulsando proyectos en <span class="text-[#88D67C]">toda Colombia</span>
        </h3>
        <p class="text-sm sm:text-base text-emerald-100/80 leading-relaxed text-justify sm:text-left text-pretty">
          Presencia estratégica y distribución oportuna de insumos fotovoltaicos, eléctricos, de construcción y seguridad en los parques solares y obras civiles más importantes del país.
        </p>
      </div>

    </div>

  </div>
</section>
