---
// Interactive Colombia Projects Map Component - Mathematical 1:1 match with WordPress
const projects = [
  {
    id: 'flandes',
    city: 'Flandes, Tolima.',
    client: 'PROYECTO CELSIA',
    title: 'SOLAR YUMA',
    image: '/images/map-project-yuma.jpg',
    pinX: 48.11,
    pinY: 55.33,
    align: 'right'
  },
  {
    id: 'dulima',
    city: 'Chicoral, Tolima.',
    client: 'PROYECTO CELSIA',
    title: 'SOLAR DULIMA',
    image: '/images/map-project-dulima.jpg',
    pinX: 46.61,
    pinY: 59.70,
    align: 'right'
  },
  {
    id: 'baranoa',
    city: 'Baranoa, Atlántico.',
    client: 'PROYECTO FOTOVOLTAICO',
    title: 'SOLAR BARANOA',
    image: '/images/map-project-baranoa.jpg',
    pinX: 44.22,
    pinY: 12.03,
    align: 'left'
  },
  {
    id: 'cartagena',
    city: 'Cartagena, Bolívar.',
    client: 'PROYECTO INDUSTRIAL',
    title: 'PARQUE SOLAR CARTAGENA',
    image: '/images/map-project-cartagena.jpg',
    pinX: 40.83,
    pinY: 16.57,
    align: 'left'
  },
  {
    id: 'valledupar',
    city: 'Valledupar, Cesar.',
    client: 'PROYECTO SOLAR',
    title: 'PARQUE SOLAR VALLEDUPAR',
    image: '/images/map-project-valledupar.jpg',
    pinX: 48.91,
    pinY: 15.64,
    align: 'right'
  }
];
---

<section class="py-20 sm:py-28 bg-[#142E16] text-white relative overflow-hidden select-none">
  <!-- Top subtle background ambient gradient -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[850px] h-[850px] bg-emerald-600/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-8 relative z-10 space-y-10 sm:space-y-14">
    
    <!-- 1. Top Section Divider: LLEGANDO LEJOS -->
    <div class="space-y-4">
      <div class="flex items-center gap-6">
        <span class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-[#7BBE6F] font-display whitespace-nowrap">
          LLEGANDO LEJOS
        </span>
        <div class="h-[1px] bg-white/20 flex-1"></div>
      </div>

      <!-- 2. Metrics & Title Row (Exact match with WordPress) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center pt-2">
        <!-- Left: +460 CLIENTES satisfechos -->
        <div class="lg:col-span-5 flex items-baseline gap-4 sm:gap-6">
          <span class="font-display text-6xl sm:text-7xl lg:text-8xl font-black text-[#88D67C] tracking-tight leading-none">
            +460
          </span>
          <div class="space-y-0.5">
            <p class="font-display font-black uppercase text-sm sm:text-base tracking-wider text-white">
              CLIENTES
            </p>
            <p class="font-display font-medium text-xs sm:text-sm text-emerald-200/80">
              satisfechos
            </p>
          </div>
        </div>

        <!-- Right: Más de una década impulsando proyectos en toda Colombia -->
        <div class="lg:col-span-7">
          <h3 class="font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white leading-tight">
            Más de una década impulsando proyectos en <span class="text-[#88D67C]">toda Colombia</span>
          </h3>
        </div>
      </div>
    </div>

    <!-- 3. Exact Panoramic Colombia Map Canvas with Clean Margin -->
    <div class="relative w-full max-w-5xl mx-auto mt-6 sm:mt-10">
      <div class="relative w-full aspect-[1044/604] flex items-center justify-center">
        
        <!-- Silhouette Map Image of Colombia -->
        <img
          src="/images/mapa-de-colombia.png"
          alt="Mapa de Cobertura de Proyectos en Colombia JIMACO"
          class="w-full h-full object-contain filter drop-shadow-[0_12px_30px_rgba(0,0,0,0.5)] pointer-events-none"
        />

        <!-- 5 Interactive Hotspot Pins (Exact Mathematical Coordinates from WordPress) -->
        {projects.map((proj, idx) => (
          <button
            type="button"
            class={`map-pin-btn absolute -translate-x-1/2 -translate-y-1/2 cursor-pointer z-30 focus:outline-none transition-transform hover:scale-125 ${idx === 0 ? 'active-pin' : ''}`}
            style={`left: ${proj.pinX}%; top: ${proj.pinY}%;`}
            data-id={proj.id}
            data-city={proj.city}
            data-client={proj.client}
            data-title={proj.title}
            data-image={proj.image}
            data-pin-x={proj.pinX}
            data-pin-y={proj.pinY}
            data-align={proj.align}
            aria-label={`Ver proyecto en ${proj.city}`}
          >
            <!-- Pin Structure matching WordPress -->
            <span class="relative flex items-center justify-center w-6 h-6 sm:w-7 sm:h-7">
              <!-- Outer amber ring border -->
              <span class="pin-ring relative inline-flex items-center justify-center w-5 h-5 sm:w-6 sm:h-6 rounded-full border border-amber-400 bg-black/30 backdrop-blur-xs transition-all shadow-xs">
                <!-- Center crisp solid white dot -->
                <span class="pin-dot w-2 h-2 rounded-full bg-white transition-all shadow-xs"></span>
              </span>
            </span>
          </button>
        ))}

        <!-- SVG Dashed Connector Line -->
        <svg
          id="connector-svg"
          class="absolute inset-0 w-full h-full pointer-events-none z-20 hidden md:block"
        >
          <line
            id="connector-line"
            x1="48.11%"
            y1="55.33%"
            x2="64%"
            y2="55.33%"
            stroke="rgba(255,255,255,0.75)"
            stroke-width="1.2"
            stroke-dasharray="3 3"
          />
        </svg>

        <!-- Active Project Info Card Overlay -->
        <div
          id="project-overlay-card"
          class="absolute z-30 transition-all duration-300 pointer-events-auto"
          style="left: 64%; top: 46%;"
        >
          <div class="w-[260px] sm:w-[300px] lg:w-[320px] bg-[#142E16]/95 backdrop-blur-md rounded-xl p-3.5 sm:p-4 border border-white/15 shadow-2xl space-y-2.5 animate-fadeIn">
            
            <!-- Location Header with Map Pin -->
            <div class="flex items-center gap-1.5 text-white">
              <svg class="w-4 h-4 text-[#88D67C] shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/>
              </svg>
              <h4 id="card-city" class="text-sm sm:text-base font-bold tracking-tight text-white font-display">
                Flandes, Tolima.
              </h4>
            </div>

            <!-- Project Thumbnail Image -->
            <div class="w-full aspect-[16/9] rounded-lg overflow-hidden shadow-md border border-white/10 bg-black/40">
              <img
                id="card-image"
                src="/images/map-project-yuma.jpg"
                alt="Proyecto Solar Yuma"
                class="w-full h-full object-cover transition-opacity duration-200"
              />
            </div>

            <!-- Client & Project Name -->
            <div class="space-y-0.5 pt-0.5">
              <p id="card-client" class="text-[10px] sm:text-xs font-extrabold uppercase tracking-widest text-emerald-300 font-display">
                PROYECTO CELSIA
              </p>
              <h3 id="card-title" class="text-sm sm:text-base font-black uppercase text-white tracking-wide font-display">
                SOLAR YUMA
              </h3>
            </div>

          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  /* Active pin style */
  .active-pin .pin-ring {
    border-color: #F59E0B;
    background-color: rgba(245, 158, 11, 0.4);
    box-shadow: 0 0 10px rgba(245, 158, 11, 0.6);
    transform: scale(1.2);
  }
  .active-pin .pin-dot {
    background-color: #FBBF24;
    transform: scale(1.25);
  }

  @keyframes fadeInCard {
    from {
      opacity: 0.6;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeIn {
    animation: fadeInCard 0.25s ease-out forwards;
  }
</style>

<script>
  function setupInteractiveMap() {
    const pins = document.querySelectorAll('.map-pin-btn');
    const card = document.getElementById('project-overlay-card');
    const cityEl = document.getElementById('card-city');
    const clientEl = document.getElementById('card-client');
    const titleEl = document.getElementById('card-title');
    const imageEl = document.getElementById('card-image') as HTMLImageElement;
    const connectorLine = document.getElementById('connector-line');

    if (!pins.length || !card || !cityEl || !clientEl || !titleEl || !imageEl || !connectorLine) return;

    let currentIndex = 0;
    let isUserInteracting = false;
    let autoRotateTimer: any = null;

    function activatePin(pin: Element) {
      pins.forEach(p => p.classList.remove('active-pin'));
      pin.classList.add('active-pin');

      const city = pin.getAttribute('data-city') || '';
      const client = pin.getAttribute('data-client') || '';
      const title = pin.getAttribute('data-title') || '';
      const image = pin.getAttribute('data-image') || '';
      const pinX = parseFloat(pin.getAttribute('data-pin-x') || '48.11');
      const pinY = parseFloat(pin.getAttribute('data-pin-y') || '55.33');
      const align = pin.getAttribute('data-align') || 'right';

      // Update Card Text and Image
      cityEl.textContent = city;
      clientEl.textContent = client;
      titleEl.textContent = title;
      imageEl.src = image;
      imageEl.alt = title;

      // Position the card and connector line based on alignment
      if (window.innerWidth >= 768) {
        if (align === 'left') {
          // Card to the left of the pin
          const cardLeft = Math.max(2, pinX - 32);
          const cardTop = Math.max(4, pinY - 8);
          card.style.left = `${cardLeft}%`;
          card.style.top = `${cardTop}%`;

          connectorLine.setAttribute('x1', `${cardLeft + 25}%`);
          connectorLine.setAttribute('y1', `${pinY}%`);
          connectorLine.setAttribute('x2', `${pinX}%`);
          connectorLine.setAttribute('y2', `${pinY}%`);
        } else {
          // Card to the right of the pin
          const cardLeft = Math.min(68, pinX + 15);
          const cardTop = Math.max(4, pinY - 8);
          card.style.left = `${cardLeft}%`;
          card.style.top = `${cardTop}%`;

          connectorLine.setAttribute('x1', `${pinX}%`);
          connectorLine.setAttribute('y1', `${pinY}%`);
          connectorLine.setAttribute('x2', `${cardLeft}%`);
          connectorLine.setAttribute('y2', `${pinY}%`);
        }
      } else {
        // Mobile layout: centered card near bottom
        card.style.left = '50%';
        card.style.top = '75%';
        card.style.transform = 'translateX(-50%)';
      }

      // Trigger animation
      card.firstElementChild?.classList.remove('animate-fadeIn');
      void (card.firstElementChild as HTMLElement)?.offsetWidth;
      card.firstElementChild?.classList.add('animate-fadeIn');
    }

    // Attach listeners
    pins.forEach((pin, idx) => {
      pin.addEventListener('mouseenter', () => {
        isUserInteracting = true;
        currentIndex = idx;
        activatePin(pin);
      });

      pin.addEventListener('click', (e) => {
        e.preventDefault();
        isUserInteracting = true;
        currentIndex = idx;
        activatePin(pin);
      });
    });

    // Auto-cycle through projects every 5 seconds if not hovering
    function startCycle() {
      if (autoRotateTimer) clearInterval(autoRotateTimer);
      autoRotateTimer = setInterval(() => {
        if (!isUserInteracting) {
          currentIndex = (currentIndex + 1) % pins.length;
          activatePin(pins[currentIndex]);
        }
      }, 5000);
    }

    startCycle();

    pins.forEach(pin => {
      pin.addEventListener('mouseleave', () => {
        setTimeout(() => { isUserInteracting = false; }, 8000);
      });
    });
  }

  // Run on page load
  setupInteractiveMap();
</script>
