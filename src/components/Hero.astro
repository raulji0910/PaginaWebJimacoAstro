---
---
<section class="relative bg-white overflow-hidden py-12 lg:py-20 border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    
    <!-- Left Column: Main Headline & Copy -->
    <div class="lg:col-span-7 space-y-6 z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-emerald-50 text-jimaco-primary border border-emerald-100 rounded-full text-xs sm:text-sm font-semibold tracking-wide uppercase">
        <span class="w-2 h-2 rounded-full bg-jimaco-accent animate-pulse"></span>
        Suministro Técnico & Industrial
      </div>

      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-jimaco-dark leading-[1.1] tracking-tight">
        Crecemos cuando juntos cuidamos del <span class="text-jimaco-primary">talento humano</span>
      </h1>

      <p class="text-lg sm:text-xl text-jimaco-grayText leading-relaxed max-w-xl">
        Conoce cómo cuidar a quienes hacen posible cada proyecto con suministros certificados y asesoría técnica de primer nivel.
      </p>

      <div class="pt-2 flex flex-wrap items-center gap-4">
        <a
          href="/suministros"
          class="inline-flex items-center gap-2 bg-jimaco-primary hover:bg-jimaco-primaryDark text-white font-display uppercase tracking-wider font-bold px-7 py-3.5 rounded-lg shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-0.5"
        >
          Ver Suministros
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>

        <a
          href="/politica-de-calidad"
          class="inline-flex items-center gap-2 text-jimaco-orange hover:text-jimaco-orangeHover font-display font-bold uppercase tracking-wider px-5 py-3.5 transition-colors group"
        >
          Conoce nuestra política
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>
    </div>

    <!-- Right Column: Hero Image -->
    <div class="lg:col-span-5 relative">
      <div class="relative rounded-2xl overflow-hidden shadow-2xl border-4 border-white">
        <img
          src="/images/hero-worker.jpg"
          alt="Operario industrial con protección personal y gafas de seguridad"
          class="w-full h-[380px] sm:h-[460px] object-cover object-center transform hover:scale-105 transition-transform duration-700"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
        <div class="absolute bottom-4 left-4 right-4 text-white">
          <p class="text-xs uppercase tracking-widest text-jimaco-accent font-bold">Seguridad y Confianza</p>
          <p class="text-sm font-semibold">Equipos certificados bajo normativas nacionales e internacionales</p>
        </div>
      </div>

      <!-- Accent badge -->
      <div class="absolute -bottom-4 -left-4 bg-white p-4 rounded-xl shadow-xl border border-gray-100 hidden sm:flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-jimaco-primary">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div>
          <p class="text-xs text-gray-500 font-medium">Garantía Certificada</p>
          <p class="text-sm font-bold text-jimaco-dark">100% Calidad JIMACO</p>
        </div>
      </div>
    </div>

  </div>
</section>
