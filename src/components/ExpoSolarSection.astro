---
---

<section class="max-w-7xl mx-auto px-4 sm:px-8 py-10">
  <div class="bg-white rounded-3xl border border-[#E1ECE0] shadow-xl overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 p-8 sm:p-12 lg:p-14 items-center">
      
      <!-- Columna Izquierda: Información Nativa -->
      <div class="lg:col-span-6 space-y-6">
        <span class="inline-block text-xs font-extrabold uppercase tracking-widest text-[#FF6A1C] font-display">
          — NOVEDAD —
        </span>

        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0B1E02] leading-tight tracking-tight">
          JIMACO estará en<br />
          <span class="text-[#0F4A1C]">ExpoSolar</span> <span class="text-[#FF6A1C]">Colombia 2026</span>
        </h2>

        <div class="space-y-1">
          <p class="text-gray-600 text-sm sm:text-base">
            El evento más importante de energías renovables en Colombia y la región.
          </p>
          <p class="text-[#0B1E02] font-bold text-sm sm:text-base">
            Conectamos soluciones, impulsamos el futuro.
          </p>
        </div>

        <!-- Badges de Fecha y Lugar -->
        <div class="flex flex-wrap gap-4 pt-2">
          <div class="flex items-center gap-3 bg-[#F4F8F3] border border-[#D4E5D1] px-4 py-2.5 rounded-xl">
            <div class="w-10 h-10 rounded-full bg-[#E1F2DF] flex items-center justify-center text-[#0F4A1C] shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            </div>
            <div>
              <strong class="block text-sm font-extrabold text-[#0F4A1C] leading-none font-display">28 - 30</strong>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-wider">OCTUBRE 2026</span>
            </div>
          </div>

          <div class="flex items-center gap-3 bg-[#F4F8F3] border border-[#D4E5D1] px-4 py-2.5 rounded-xl">
            <div class="w-10 h-10 rounded-full bg-[#E1F2DF] flex items-center justify-center text-[#0F4A1C] shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </div>
            <div>
              <strong class="block text-sm font-extrabold text-[#0F4A1C] leading-none font-display">BOGOTÁ, COLOMBIA</strong>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-wider">CORFERIAS</span>
            </div>
          </div>
        </div>

        <!-- Botón CTA -->
        <div class="pt-2">
          <a href="/contacto" class="inline-flex items-center gap-2 border-2 border-[#0F4A1C] text-[#0F4A1C] px-6 py-3 rounded-lg font-display font-extrabold text-xs tracking-wider uppercase hover:bg-[#0F4A1C] hover:text-white transition-all group">
            PRÓXIMAMENTE MÁS INFORMACIÓN
            <span class="text-[#FF6A1C] group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Imagen Gráfica -->
      <div class="lg:col-span-6">
        <div class="rounded-2xl overflow-hidden border border-[#E1ECE0] shadow-md hover:shadow-lg transition-shadow">
          <img src="/images/NoticiaExposolar.png" alt="ExpoSolar Colombia 2026 JIMACO" class="w-full h-auto object-cover" />
        </div>
      </div>

    </div>

    <!-- Franja Inferior -->
    <div class="bg-[#063A16] px-6 py-4 flex flex-wrap justify-around items-center gap-4 text-white text-xs font-bold font-display uppercase tracking-wider border-t border-white/10">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[#7BBE6F]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        <span>CALIDAD QUE NOS DEFINE</span>
      </div>
      <span class="hidden sm:inline text-white/20">|</span>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[#7BBE6F]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        <span>PROCESOS QUE NOS FORTALECEN</span>
      </div>
      <span class="hidden sm:inline text-white/20">|</span>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[#7BBE6F]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
        <span>ESTÁNDARES QUE NOS GUÍAN</span>
      </div>
      <span class="hidden sm:inline text-white/20">|</span>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-[#7BBE6F]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
        <span>MEJORA CONTINUA QUE NOS IMPULSA</span>
      </div>
    </div>

  </div>
</section>
