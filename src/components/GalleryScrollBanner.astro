---
// Franja animada con los productos de la Tienda Virtual.
import { PRODUCTS } from '../data/store';

const galleryItems = PRODUCTS.map((p) => ({ img: p.image, alt: p.name }));
---

<section class="w-full py-12 sm:py-16 bg-white overflow-hidden border-b border-gray-100" data-scroll-animate="up">
  <div class="relative w-full">
    <!-- Continuous Infinite Scrolling Track -->
    <div class="gallery-marquee-track flex w-max gap-4 sm:gap-6 items-center select-none">
      
      <!-- Sequence Set 1 -->
      {galleryItems.map((item) => (
        <a href="/tienda" class="w-48 sm:w-56 md:w-64 aspect-square rounded-2xl overflow-hidden shadow-md hover:shadow-xl border border-gray-100 bg-white shrink-0 group transition-all duration-300 transform hover:-translate-y-1 flex flex-col" title={item.alt}>
          <div class="flex-1 min-h-0 p-4 flex items-center justify-center">
            <img
              src={item.img}
              alt={item.alt}
              class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              draggable="false"
            />
          </div>
          <p class="px-3 py-2 border-t border-gray-100 text-[11px] sm:text-xs font-display font-bold text-jimaco-dark leading-snug line-clamp-2">{item.alt}</p>
        </a>
      ))}

      <!-- Duplicate Sequence Set for Seamless Loop -->
      {galleryItems.map((item) => (
        <a href="/tienda" class="w-48 sm:w-56 md:w-64 aspect-square rounded-2xl overflow-hidden shadow-md hover:shadow-xl border border-gray-100 bg-white shrink-0 group transition-all duration-300 transform hover:-translate-y-1 flex flex-col" title={item.alt}>
          <div class="flex-1 min-h-0 p-4 flex items-center justify-center">
            <img
              src={item.img}
              alt={item.alt}
              class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              draggable="false"
            />
          </div>
          <p class="px-3 py-2 border-t border-gray-100 text-[11px] sm:text-xs font-display font-bold text-jimaco-dark leading-snug line-clamp-2">{item.alt}</p>
        </a>
      ))}

    </div>
  </div>
</section>

<style>
  @keyframes galleryScroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .gallery-marquee-track {
    animation: galleryScroll 70s linear infinite;
    will-change: transform;
  }

  .gallery-marquee-track:hover {
    animation-play-state: paused;
  }
</style>
