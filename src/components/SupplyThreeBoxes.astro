---
const boxes = [
  {
    title: 'Suministros para construcción',
    image: '/images/suministros-construccion-pic.jpg',
    link: '/suministros/construccion',
    desc: 'Tubería, perfiles, herramientas y materiales de alta resistencia para obra civil.'
  },
  {
    title: 'Todo en energía fotovoltaica',
    image: '/images/suministros-paneles-solares-1.jpg',
    link: '/suministros/energia-solar',
    desc: 'Importadores directos de placas subterráneas, tubería PEAD y cable solar certificado.'
  },
  {
    title: 'Equipos de Protección Personal',
    image: '/images/suministros-construccion-1.jpg',
    link: '/suministros/proteccion-personal',
    desc: 'Cascos, arneses, gafas y calzado con normativas ANSI / OSHA para seguridad laboral.'
  }
];
---

<section class="py-12 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 -mt-20 relative z-30">
      {boxes.map((b) => (
        <a
          href={b.link}
          class="group relative h-80 sm:h-96 rounded-2xl overflow-hidden shadow-2xl border border-white/20 flex flex-col justify-end p-6 sm:p-8 transform hover:-translate-y-2 transition-all duration-500"
        >
          <!-- Background Image -->
          <img
            src={b.image}
            alt={b.title}
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0B1E02] via-[#0B1E02]/60 to-transparent"></div>

          <!-- Content -->
          <div class="relative z-10 space-y-2 text-white">
            <h3 class="font-display text-2xl font-bold leading-tight group-hover:text-jimaco-accent transition-colors">
              {b.title}
            </h3>
            <p class="text-xs sm:text-sm text-white/80 line-clamp-2 leading-relaxed">
              {b.desc}
            </p>
            <div class="pt-2 flex items-center gap-2 text-jimaco-orange font-display font-bold uppercase text-xs tracking-wider">
              <span>Ver más</span>
              <span class="group-hover:translate-x-1.5 transition-transform text-sm">→</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
