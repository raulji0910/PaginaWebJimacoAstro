      ['Material', 'PEAD (polietileno de alta densidad)'],
      ['Construcción', 'Doble pared'],
      ['Protección UV', 'Estabilizada para exposición exterior'],
      ['Resistencia a la tensión', '≥ 10 MPa']
    ],
    highlights: ['Protección UV', 'Doble pared', 'Exposición exterior', 'Resistencia ≥ 10 MPa']
  },
