---
import type { StoreProduct as Product } from '../data/store';

interface Props {
  product: Product;
}

const { product } = Astro.props;

function formatCOP(amount: number) {
  return new Intl.NumberFormat('es-CO', {
    style: 'currency',
    currency: 'COP',
    maximumFractionDigits: 0
  }).format(amount);
}

const discountPercent = product.originalPrice && product.originalPrice > product.price
  ? Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100)
  : null;
---

<div
  class="product-card group bg-white rounded-2xl border border-gray-200/80 hover:border-jimaco-primary/50 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between overflow-hidden relative"
  data-id={product.id}
  data-name={product.name.toLowerCase()}
  data-brand={product.brand.toLowerCase()}
  data-category={product.category}
  data-price={product.price}
  data-stock={product.stock}
>
  <!-- Badges Flotantes Superiores -->
  <div class="absolute top-3 left-3 z-10 flex flex-col gap-1.5 items-start">
    {discountPercent && (
      <span class="bg-red-500 text-white font-display font-extrabold text-[10px] px-2 py-0.5 rounded-md uppercase tracking-wider shadow-xs">
        {discountPercent}% OFF
      </span>
    )}
    {product.badge && (
      <span class="bg-jimaco-orange text-white font-display font-bold text-[10px] px-2 py-0.5 rounded-md uppercase tracking-wider shadow-xs">
        {product.badge}
      </span>
    )}
  </div>

  <!-- Botón Flotante Vista Rápida -->
  <button
    type="button"
    class="quick-view-trigger-btn absolute top-3 right-3 z-10 w-9 h-9 rounded-full bg-white/90 hover:bg-white text-gray-600 hover:text-jimaco-primary shadow-md flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all transform group-hover:scale-105 cursor-pointer"
    title="Vista rápida del producto"
    data-product={JSON.stringify(product)}
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
    </svg>
  </button>

  <!-- Imagen del Producto -->
  <div class="p-5 bg-gradient-to-b from-gray-50/70 to-white flex items-center justify-center relative overflow-hidden aspect-4/3">
    <img
      src={product.image}
      alt={product.name}
      class="max-h-40 w-auto object-contain transition-transform duration-500 group-hover:scale-108"
      loading="lazy"
    />
  </div>

  <!-- Contenido de la Tarjeta -->
  <div class="p-4 sm:p-5 flex-1 flex flex-col justify-between border-t border-gray-100">
    <div>
      <!-- Marca, SKU y Categoría -->
      <div class="flex items-center justify-between text-[11px] text-gray-500 mb-1">
        <span class="font-extrabold uppercase tracking-wider text-jimaco-primary font-display">
          {product.brand}
        </span>
        <span class="font-mono text-gray-400 text-[10px]">
          {product.sku}
        </span>
      </div>

      <!-- Título del Producto -->
      <h3 class="text-sm font-bold font-sans text-gray-900 group-hover:text-jimaco-primary transition-colors line-clamp-2 leading-snug mb-2" title={product.name}>
        {product.name}
      </h3>

      <!-- Estrellas y Opiniones -->
      <div class="flex items-center gap-1.5 text-xs mb-3">
        <div class="flex text-amber-400 text-[11px]">
          ★★★★★
        </div>
        <span class="text-[11px] font-bold text-gray-600">{product.rating || '4.9'}</span>
        <span class="text-[10px] text-gray-400">({product.reviewsCount || '25'})</span>
      </div>
    </div>

    <div>
      <!-- Bloque de Precios (Estilo Mercado Libre) -->
      <div class="mb-3 pt-2 border-t border-gray-100/80">
        {product.originalPrice && product.originalPrice > product.price && (
          <div class="text-[11px] text-gray-400 line-through">
            {formatCOP(product.originalPrice)}
          </div>
        )}
        <div class="flex items-baseline gap-1.5">
          <span class="text-xl sm:text-2xl font-extrabold text-jimaco-dark font-display">
            {formatCOP(product.price)}
          </span>
          <span class="text-[10px] text-gray-500 font-medium">
            / {product.unit}
          </span>
        </div>
        <p class="text-[10px] text-emerald-700 font-semibold mt-0.5 flex items-center gap-1">
          <svg class="w-3 h-3 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
          </svg>
          IVA incluido • Factura electrónica
        </p>
      </div>

      <!-- Disponibilidad y Retiro en Bodega -->
      <div class="text-[10px] text-gray-500 bg-gray-50 rounded-lg px-2.5 py-1.5 mb-3.5 flex items-center justify-between">
        <span class="text-emerald-700 font-bold flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          Stock: {product.stock} {product.unit}s
        </span>
        <span class="text-gray-500">Bodega Bogotá</span>
      </div>

      <!-- Botones de Acción -->
      <div class="grid grid-cols-5 gap-2">
        <!-- Botón Agregar al Carrito -->
        <button
          type="button"
          class="add-to-cart-btn col-span-4 bg-jimaco-orange hover:bg-jimaco-orangeHover text-white font-display font-bold uppercase tracking-wider text-[11px] py-2.5 px-3 rounded-xl shadow-xs hover:shadow-md transition-all flex items-center justify-center gap-1.5 transform active:scale-95 cursor-pointer"
          data-product={JSON.stringify(product)}
        >
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>
          <span>Agregar</span>
        </button>

        <!-- Botón Cotizar Rápido por WhatsApp -->
        <a
          href={`https://wa.me/573123503397?text=Hola%20JIMACO,%20estoy%20interesado%20en%20cotizar%20el%20producto:%20*${encodeURIComponent(product.name)}*%20(SKU:%20${product.sku})`}
          target="_blank"
          rel="noopener noreferrer"
          class="col-span-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 rounded-xl flex items-center justify-center transition-colors border border-emerald-200/60 cursor-pointer"
          title="Cotizar directo por WhatsApp"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.586 1.761.882 2.791.882h.004c3.179 0 5.767-2.587 5.767-5.766.001-3.187-2.575-5.768-5.77-5.768zm3.376 8.163c-.144.405-.837.774-1.17.824-.312.045-.634.06-1.579-.331-.767-.318-1.572-.942-2.284-1.654-.712-.712-1.336-1.517-1.654-2.284-.391-.945-.376-1.267-.331-1.579.05-.333.419-1.026.824-1.17.135-.048.28-.063.409-.063.136 0 .273.003.391.01.12.007.28-.045.438.334.164.394.56 1.365.61 1.465.05.1.083.218.016.35-.067.133-.1.217-.199.333-.1.117-.21.261-.3.35-.1.1-.205.209-.088.409.117.2.52 1.026 1.114 1.556.767.683 1.414.894 1.614.994.2.1.317.083.434-.05.117-.133.5-.583.633-.783.133-.2.267-.167.45-.1.183.067 1.167.55 1.367.65.2.1.333.15.383.233.05.083.05.483-.094.888z"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

