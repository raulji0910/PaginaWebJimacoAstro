<!-- Script de Interactividad Dinámica en el Cliente -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Selector de Variantes (Miniaturas)
    const variantBtns = document.querySelectorAll('.variant-btn');
    const mainImg = document.getElementById('main-product-image');
    const activeBadge = document.getElementById('active-badge');
    const activeSubtitle = document.getElementById('active-subtitle');
    const specAplicacion = document.getElementById('spec-aplicacion');
    const specNorma = document.getElementById('spec-norma');
    const specLongitud = document.getElementById('spec-longitud');
    const specTemperatura = document.getElementById('spec-temperatura');
    const ctaWa = document.getElementById('cta-whatsapp-quote');

    let currentVariantName = 'Tubería PVC Conduit Eléctrica';
    let currentDiameter = '1"';

    function updateWhatsAppLink() {
      if (!ctaWa) return;
      const text = encodeURIComponent(
        `Hola JIMACO, deseo cotizar ${currentVariantName} en diámetro ${currentDiameter} para un proyecto. ¿Qué disponibilidad tienen en bodega Bogotá?`
      );
      ctaWa.href = `https://wa.me/573123503397?text=${text}`;
    }

    variantBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Reset estilos de botones
        variantBtns.forEach(b => {
          b.classList.remove('border-jimaco-primary', 'bg-sky-50/50', 'shadow-md', 'ring-2', 'ring-jimaco-primary/20');
          b.classList.add('border-gray-200', 'bg-white');
        });

        // Activar botón seleccionado
        btn.classList.add('border-jimaco-primary', 'bg-sky-50/50', 'shadow-md', 'ring-2', 'ring-jimaco-primary/20');
        btn.classList.remove('border-gray-200', 'bg-white');

        // Leer data attributes
        const { name, badge, subtitle, image, aplicacion, norma, longitud, temperatura } = btn.dataset;
        currentVariantName = name;

        // Actualizar UI
        if (mainImg) {
          mainImg.style.opacity = '0.3';
          setTimeout(() => {
            mainImg.src = image;
            mainImg.style.opacity = '1';
          }, 150);
        }
        if (activeBadge) activeBadge.textContent = badge;
        if (activeSubtitle) activeSubtitle.textContent = subtitle;
        if (specAplicacion) specAplicacion.textContent = aplicacion;
        if (specNorma) specNorma.textContent = norma;
        if (specLongitud) specLongitud.textContent = longitud;
        if (specTemperatura) specTemperatura.textContent = temperatura;

        updateWhatsAppLink();
      });
    });

    // 2. Selector de Diámetros
    const diameterBtns = document.querySelectorAll('.diameter-btn');
    const activeDiameterLabel = document.getElementById('active-diameter-label');
    const activePsiLabel = document.getElementById('active-psi-label');
    const activeStockLabel = document.getElementById('active-stock-label');

    diameterBtns.forEach(dBtn => {
      dBtn.addEventListener('click', () => {
        diameterBtns.forEach(b => {
          b.classList.remove('border-jimaco-orange', 'bg-jimaco-orange', 'text-white', 'shadow-sm');
          b.classList.add('border-gray-200', 'bg-white', 'text-gray-700');
        });

        dBtn.classList.add('border-jimaco-orange', 'bg-jimaco-orange', 'text-white', 'shadow-sm');
        dBtn.classList.remove('border-gray-200', 'bg-white', 'text-gray-700');

        const { diameter, mm, psi, stock } = dBtn.dataset;
        currentDiameter = diameter;

        if (activeDiameterLabel) activeDiameterLabel.textContent = `${diameter} (${mm} ext.)`;
        if (activePsiLabel) activePsiLabel.textContent = `• Presión: ${psi}`;
        if (activeStockLabel) activeStockLabel.textContent = stock;

        updateWhatsAppLink();
      });
    });
  });
</script>

