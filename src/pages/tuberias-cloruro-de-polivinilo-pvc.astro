---
import Layout from '../layouts/Layout.astro';
import CommercialTeamBanner from '../components/CommercialTeamBanner.astro';

// Datos de variantes de producto (Inspirado en ALR Group)
const variants = [
  {
    id: 'pvc-conduit',
    name: 'Tubería PVC Conduit Eléctrica',
    badge: 'Certificado RETIE / NTC 2050',
    subtitle: 'Protección de cableado eléctrico en baja y media tensión, redes solares e industriales.',
    color: 'border-amber-500 bg-amber-50/40 text-amber-900',
    tagColor: 'bg-amber-600',
    mainImage: '/images/productos/1-tuberia-sanitaria-1.jpg',
    thumbnail: '/images/productos/1-tuberia-sanitaria-1.jpg',
    specs: {
      aplicacion: 'Canalización eléctrica embutida y a la vista',
      norma: 'NTC 979 / NTC 2050 / RETIE',
      temperatura: 'Hasta 60°C en servicio continuo',
      comportamientoFuego: 'Autoextinguible, no propaga la llama',
      longitud: 'Tramos de 3.00 y 6.00 metros con campana'
    }
  },
  {
    id: 'pvc-sanitaria',
    name: 'Tubería Sanitaria & Desagüe Pavco Wavin',
    badge: 'Norma NTC 1082 / ASTM D2665',
    subtitle: 'Conducción de aguas residuales, ventilación y pluviales en edificaciones y obras civiles.',
    color: 'border-blue-500 bg-blue-50/40 text-blue-900',
    tagColor: 'bg-blue-600',
    mainImage: '/images/productos/tubos-sanitario.jpg',
    thumbnail: '/images/productos/tubos-sanitario.jpg',
    specs: {
      aplicacion: 'Desagües sanitarios, bajantes pluviales y ventilación',
      norma: 'NTC 1082 / ASTM D2665',
      temperatura: 'Resistente a vertimientos domésticos e industriales hasta 60°C',
      comportamientoFuego: 'Inerte, resistente al impacto y químicos',
      longitud: 'Tramos de 6.00 metros con campana soldable'
    }
  },
  {
    id: 'pvc-presion',
    name: 'Tubería PVC Presión RDE (Acueducto)',
    badge: 'Norma NTC 382 / ASTM D2241',
    subtitle: 'Distribución de agua potable a presión en plantas industriales, acueductos y riego.',
    color: 'border-emerald-500 bg-emerald-50/40 text-emerald-900',
    tagColor: 'bg-emerald-600',
    mainImage: '/images/productos/tubos-para-sanitario.jpg',
    thumbnail: '/images/productos/tubos-para-sanitario.jpg',
    specs: {
      aplicacion: 'Redes primarias y secundarias de agua potable a presión',
      norma: 'NTC 382 / ASTM D2241',
      temperatura: '23°C (Tolerancia térmica operativa 5°C - 45°C)',
      comportamientoFuego: 'Presión hasta 200 - 315 PSI según RDE',
      longitud: 'Tramos de 6.00 metros con unión mecánica o soldable'
    }
  },
  {
    id: 'pvc-accesorios',
    name: 'Accesorios, Cajetines y Codos PVC',
    badge: 'Gama Completa Pavco / Legrand',
    subtitle: 'Uniones, codos de 45° y 90°, tees, cajas de paso 4x4, bujes y adaptadores macho/hembra.',
    color: 'border-purple-500 bg-purple-50/40 text-purple-900',
    tagColor: 'bg-purple-600',
    mainImage: '/images/productos/detail-shot-pipes.jpg',
    thumbnail: '/images/productos/detail-shot-pipes.jpg',
    specs: {
      aplicacion: 'Conexión, derivación y empalmes estancos',
      norma: 'NTC 1339 / NTC 2293',
      temperatura: 'Máxima compatibilidad química con soldadura PVC',
      comportamientoFuego: 'Cierre hermético sin fugas mecánicas',
      longitud: 'Dimensiones milimétricas y pulgadas estandarizadas'
    }
  }
];

// Medidas y diámetros típicos disponibles en JIMACO
const diameters = [
  { name: '1/2"', mmExt: '21.3 mm', espesor: '1.8 mm', psi: '315 PSI', stock: 'En Stock (+500 tubos)' },
  { name: '3/4"', mmExt: '26.7 mm', espesor: '2.0 mm', psi: '250 PSI', stock: 'En Stock (+450 tubos)' },
  { name: '1"', mmExt: '33.4 mm', espesor: '2.5 mm', psi: '200 PSI', stock: 'En Stock (+380 tubos)' },
  { name: '1-1/2"', mmExt: '48.3 mm', espesor: '2.8 mm', psi: '200 PSI', stock: 'En Stock (+260 tubos)' },
  { name: '2"', mmExt: '60.3 mm', espesor: '3.2 mm', psi: '160 PSI', stock: 'En Stock (+320 tubos)' },
  { name: '3"', mmExt: '88.9 mm', espesor: '3.8 mm', psi: '160 PSI', stock: 'En Stock (+180 tubos)' },
  { name: '4"', mmExt: '114.3 mm', espesor: '4.5 mm', psi: '160 PSI', stock: 'En Stock (+150 tubos)' },
  { name: '6"', mmExt: '168.3 mm', espesor: '6.2 mm', psi: '125 PSI', stock: 'En Stock (+90 tubos)' }
];
---

<Layout
  title="Tuberías Cloruro de Polivinilo PVC Certificadas — JIMACO"
  description="Ductería y tuberías PVC para construcción, redes eléctricas RETIE, acueducto y alcantarillado. Precios por mayor, certificación NTC y entrega inmediata en obra desde Bogotá."
>
  <!-- Barra Superior de Garantía Industrial B2B -->
  <div class="bg-jimaco-dark text-white text-xs border-b border-white/10 py-2.5 px-4">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3 text-[11px] sm:text-xs">
      <div class="flex items-center gap-3 flex-wrap">
        <span class="inline-flex items-center gap-1.5 text-amber-400 font-bold uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Stock Permanente en Bodega Bogotá (Samper Mendoza)
        </span>
        <span class="hidden md:inline-block text-gray-500">•</span>
        <span class="text-gray-300">
          Distribución a Nivel Nacional • Cumple Normas RETIE, NTC 1082 y NTC 2050
        </span>
      </div>
      <div class="flex items-center gap-3">
        <a href="#cotizador-rapido" class="text-jimaco-orange hover:text-amber-300 font-bold transition-colors">
          Cotización Formal con Asesor B2B &rarr;
        </a>
      </div>
    </div>
  </div>

  <!-- Breadcrumbs & Navegación -->
  <div class="bg-gray-50 border-b border-gray-200/80 py-3 px-4">
    <div class="max-w-7xl mx-auto">
      <nav class="flex text-xs text-gray-500 font-medium" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1.5 sm:space-x-2">
          <li><a href="/" class="hover:text-jimaco-primary">Inicio</a></li>
          <li><span>/</span></li>
          <li><a href="/suministros-para-construccion" class="hover:text-jimaco-primary">Suministros Construcción</a></li>
          <li><span>/</span></li>
          <li class="text-jimaco-primary font-bold">Tuberías Cloruro de Polivinilo (PVC)</li>
        </ol>
      </nav>
    </div>
  </div>

  <!-- SECCIÓN 1: HERO INDUSTRIAL DE ALTA CONVERSIÓN (Inspirado en ALR Group) -->
  <section class="py-8 sm:py-12 bg-gradient-to-b from-white via-gray-50/50 to-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-[40px]">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- Columna Izquierda: Galería Interactiva de Producto -->
        <div class="lg:col-span-7 flex flex-col gap-4">
          
          <!-- Contenedor Imagen Principal -->
          <div class="relative bg-white rounded-3xl p-6 sm:p-8 border-2 border-gray-200 shadow-lg overflow-hidden flex items-center justify-center min-h-[380px] sm:min-h-[460px] group">
            
            <!-- Badges Flotantes -->
            <div class="absolute top-4 left-4 z-10 flex flex-col gap-2 items-start">
              <span id="active-badge" class="bg-jimaco-primary text-white font-display font-extrabold text-xs px-3 py-1 rounded-lg uppercase tracking-wider shadow-md">
                Certificado RETIE / NTC 1082
              </span>
              <span class="bg-emerald-600 text-white font-sans font-bold text-[10px] px-2.5 py-0.5 rounded-md uppercase tracking-wider shadow-sm flex items-center gap-1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                Disponibilidad Inmediata
              </span>
            </div>

            <!-- Botón Zoom / Pantalla Completa -->
            <div class="absolute top-4 right-4 z-10 bg-white/90 backdrop-blur-xs text-gray-700 p-2 rounded-xl shadow-xs border border-gray-200 text-xs flex items-center gap-1.5 font-bold">
              <span>Zoom 100%</span>
            </div>

            <!-- Imagen Principal Interactiva -->
            <img
              id="main-product-image"
              src={variants[0].mainImage}
              alt="Tuberías Cloruro de Polivinilo PVC JIMACO"
              class="max-h-[320px] sm:max-h-[380px] w-auto object-contain transition-all duration-500 transform group-hover:scale-105"
            />

            <!-- Sello de Marca de Agua de Fábrica -->
            <div class="absolute bottom-4 right-4 text-[10px] text-gray-400 font-mono font-bold tracking-widest uppercase">
              JIMACO S.A.S. • BOGOTÁ
            </div>
          </div>

          <!-- Selector de Variantes (Miniaturas Interactivas Estilo ALR Group) -->
          <div>
            <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2.5 flex items-center justify-between">
              <span>Selecciona una Línea o Aplicación:</span>
              <span class="text-jimaco-primary font-mono text-[11px]">4 Tipos de Tubería Disponibles</span>
            </p>
            
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
              {variants.map((variant, index) => (
                <button
                  type="button"
                  class={`variant-btn text-left p-3 rounded-2xl border-2 transition-all cursor-pointer flex flex-col gap-2 ${
                    index === 0 
                      ? 'border-jimaco-primary bg-sky-50/50 shadow-md ring-2 ring-jimaco-primary/20' 
                      : 'border-gray-200 bg-white hover:border-gray-300 hover:shadow-xs'
                  }`}
                  data-variant-id={variant.id}
                  data-name={variant.name}
                  data-badge={variant.badge}
                  data-subtitle={variant.subtitle}
                  data-image={variant.mainImage}
                  data-aplicacion={variant.specs.aplicacion}
                  data-norma={variant.specs.norma}
                  data-temperatura={variant.specs.temperatura}
                  data-fuego={variant.specs.comportamientoFuego}
                  data-longitud={variant.specs.longitud}
                >
                  <div class="h-14 w-full bg-gray-50 rounded-xl overflow-hidden flex items-center justify-center p-1">
                    <img src={variant.thumbnail} alt={variant.name} class="h-full object-contain" />
                  </div>
                  <div>
                    <h4 class="text-[11px] font-bold text-gray-900 leading-tight line-clamp-1">{variant.name}</h4>
                    <span class="text-[9px] text-gray-500 font-medium block truncate mt-0.5">{variant.badge}</span>
                  </div>
                </button>
              ))}
            </div>
          </div>

        </div>

        <!-- Columna Derecha: Información Técnica, Medidas y Botones de Acción -->
        <div class="lg:col-span-5 flex flex-col justify-between">
          
          <div>
            <!-- Marca y Certificación -->
            <div class="flex items-center gap-2 mb-2">
              <span class="bg-gray-100 text-gray-700 text-[10px] font-bold px-2.5 py-0.5 rounded uppercase tracking-wider">
                Línea Obra & Redes Eléctricas
              </span>
              <span class="text-gray-400 text-xs">•</span>
              <span class="text-emerald-700 font-bold text-xs flex items-center gap-1">
                Norma RETIE / NTC 2050
              </span>
            </div>

            <!-- Título Principal -->
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold font-display uppercase tracking-tight text-jimaco-dark leading-none mb-3">
              Tuberías Cloruro de Polivinilo (PVC)
            </h1>

            <!-- Subtítulo Dinámico -->
            <p id="active-subtitle" class="text-sm text-gray-600 leading-relaxed mb-5">
              {variants[0].subtitle}
            </p>

            <!-- Cuadrícula de Especificaciones Clave de la Variante -->
            <div class="bg-gray-50 border border-gray-200 rounded-2xl p-4 mb-6 text-xs space-y-2">
              <div class="flex justify-between py-1 border-b border-gray-200/70">
                <span class="text-gray-500 font-medium">Aplicación Principal:</span>
                <span id="spec-aplicacion" class="font-bold text-gray-900 text-right max-w-[240px] truncate">
                  {variants[0].specs.aplicacion}
                </span>
              </div>
              <div class="flex justify-between py-1 border-b border-gray-200/70">
                <span class="text-gray-500 font-medium">Norma Técnica:</span>
                <span id="spec-norma" class="font-bold text-jimaco-primary text-right">
                  {variants[0].specs.norma}
                </span>
              </div>
              <div class="flex justify-between py-1 border-b border-gray-200/70">
                <span class="text-gray-500 font-medium">Longitud de Tubo:</span>
                <span id="spec-longitud" class="font-bold text-gray-900 text-right">
                  {variants[0].specs.longitud}
                </span>
              </div>
              <div class="flex justify-between py-1">
                <span class="text-gray-500 font-medium">Resistencia Térmica:</span>
                <span id="spec-temperatura" class="font-bold text-gray-900 text-right">
                  {variants[0].specs.temperatura}
                </span>
              </div>
            </div>

            <!-- Selector de Diámetros en Pulgadas (Selector B2B) -->
            <div class="mb-6">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">
                Selecciona el Diámetro / Calibre:
              </label>
              <div class="grid grid-cols-4 sm:grid-cols-8 gap-2">
                {diameters.map((d, i) => (
                  <button
                    type="button"
                    class={`diameter-btn py-2 px-1 text-center rounded-xl border font-bold text-xs transition-all cursor-pointer ${
                      i === 2 
                        ? 'border-jimaco-orange bg-jimaco-orange text-white shadow-sm' 
                        : 'border-gray-200 bg-white text-gray-700 hover:border-gray-400'
                    }`}
                    data-diameter={d.name}
                    data-mm={d.mmExt}
                    data-espesor={d.espesor}
                    data-psi={d.psi}
                    data-stock={d.stock}
                  >
                    {d.name}
                  </button>
                ))}
              </div>

              <!-- Ficha rápida del diámetro seleccionado -->
              <div class="mt-3 bg-amber-50/70 border border-amber-200/80 rounded-xl p-3 flex items-center justify-between text-xs text-amber-950">
                <div>
                  <span class="font-bold">Medida Activa: </span>
                  <span id="active-diameter-label" class="font-extrabold text-jimaco-orange">1" (33.4 mm ext.)</span>
                  <span class="text-gray-500 text-[11px] block sm:inline sm:ml-2" id="active-psi-label">• Presión: 200 PSI</span>
                </div>
                <span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded-md" id="active-stock-label">
                  En Stock
                </span>
              </div>
            </div>

          </div>

          <!-- CTAs de Conversión Rápida (WhatsApp Directo + Catálogo) -->
          <div id="cotizador-rapido" class="pt-4 border-t border-gray-200 flex flex-col gap-3">
            
            <!-- Botón Principal: Cotizar por WhatsApp con Mensaje Prellenado -->
            <a
              id="cta-whatsapp-quote"
              href="https://wa.me/573123503397?text=Hola%20JIMACO,%20deseo%20cotizar%20Tuber%C3%ADa%20PVC%20Conduit%20El%C3%A9ctrica%20en%20di%C3%A1metro%201%20pulgada%20para%20un%20proyecto."
              target="_blank"
              rel="noopener noreferrer"
              class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-display font-extrabold uppercase tracking-wider text-sm py-4 px-6 rounded-2xl shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-3 transform active:scale-98 cursor-pointer"
            >
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.586 1.761.882 2.791.882h.004c3.179 0 5.767-2.587 5.767-5.766.001-3.187-2.575-5.768-5.77-5.768zm3.376 8.163c-.144.405-.837.774-1.17.824-.312.045-.634.06-1.579-.331-.767-.318-1.572-.942-2.284-1.654-.712-.712-1.336-1.517-1.654-2.284-.391-.945-.376-1.267-.331-1.579.05-.333.419-1.026.824-1.17.135-.048.28-.063.409-.063.136 0 .273.003.391.01.12.007.28-.045.438.334.164.394.56 1.365.61 1.465.05.1.083.218.016.35-.067.133-.1.217-.199.333-.1.117-.21.261-.3.35-.1.1-.205.209-.088.409.117.2.52 1.026 1.114 1.556.767.683 1.414.894 1.614.994.2.1.317.083.434-.05.117-.133.5-.583.633-.783.133-.2.267-.167.45-.1.183.067 1.167.55 1.367.65.2.1.333.15.383.233.05.083.05.483-.094.888z"></path>
              </svg>
              <span>Solicitar cotización por WhatsApp</span>
            </a>

            <!-- Fila de Botones Secundarios: Llamar directo & Ver catálogo -->
            <div class="grid grid-cols-2 gap-3 text-xs">
              <a
                href="tel:+573123503397"
                class="bg-white hover:bg-gray-100 text-gray-800 font-bold py-3 px-4 rounded-xl border border-gray-300 text-center flex items-center justify-center gap-2 transition-colors"
              >
                <svg class="w-4 h-4 text-jimaco-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                <span>Llamar al Asesor</span>
              </a>
              <a
                href="/catalogo"
                class="bg-jimaco-primary hover:bg-jimaco-primaryHover text-white font-bold py-3 px-4 rounded-xl text-center flex items-center justify-center gap-2 transition-colors"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                <span>Ver catálogo de productos</span>
              </a>
            </div>

            <!-- Garantía de Facturación -->
            <p class="text-[11px] text-gray-500 text-center flex items-center justify-center gap-1.5 mt-1">
              <svg class="w-3.5 h-3.5 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
              <span>Emitimos Factura Electrónica DIAN y Certificados de Conformidad</span>
            </p>

          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- SECCIÓN 2: VENTAJAS TÉCNICAS DEL PVC (Los 4 Blurbs clave de ALR Group) -->
  <section class="py-12 sm:py-16 bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-[40px]">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-jimaco-orange font-display font-extrabold text-xs uppercase tracking-widest">
          Propiedades y Beneficios Industriales
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold font-display uppercase tracking-tight text-jimaco-dark mt-1">
          Ventajas de las Tuberías de Cloruro de Polivinilo (PVC)
        </h2>
        <p class="text-sm text-gray-600 mt-2">
          El PVC es uno de los polímeros más versátiles y confiables para obras civiles, instalaciones eléctricas y conducción hidráulica.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Tarjeta 1: Resistencia y Flexibilidad -->
        <div class="bg-gray-50 hover:bg-white rounded-3xl p-6 border border-gray-200 hover:border-jimaco-primary/40 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center mb-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
            </div>
            <h3 class="text-base font-bold text-gray-900 font-display uppercase tracking-wide mb-2">
              Resistencia & Flexibilidad
            </h3>
            <p class="text-xs text-gray-600 leading-relaxed">
              Alta tolerancia mecánica que soporta cargas de compactación de suelos, vibraciones y movimientos de tierra sin riesgo de fracturas ni deformaciones.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-gray-200/60 text-[11px] font-bold text-jimaco-primary">
            Ideal para zanjas y pisos industriales
          </div>
        </div>

        <!-- Tarjeta 2: Aislamiento Dieléctrico RETIE -->
        <div class="bg-gray-50 hover:bg-white rounded-3xl p-6 border border-gray-200 hover:border-jimaco-primary/40 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-blue-100 text-blue-700 flex items-center justify-center mb-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            </div>
            <h3 class="text-base font-bold text-gray-900 font-display uppercase tracking-wide mb-2">
              Seguridad Eléctrica RETIE
            </h3>
            <p class="text-xs text-gray-600 leading-relaxed">
              Material 100% aislante dieléctrico que no conduce la electricidad y es autoextinguible (no propaga la llama), protegiendo cableados solares e industriales.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-gray-200/60 text-[11px] font-bold text-jimaco-primary">
            Cumple NTC 2050 Código Eléctrico
          </div>
        </div>

