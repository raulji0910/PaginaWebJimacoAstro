---
import Layout from '../layouts/Layout.astro';
import EntregasCarousel from '../components/EntregasCarousel.astro';

const WA = (text: string) => `https://wa.me/573123503397?text=${encodeURIComponent(text)}`;

// Cuatro razones para elegirla
const pillars = [
  ['Larga vida útil', 'El polietileno de alta densidad aguanta el agua, la oxidación, el calor y el frío intensos y la luz solar directa, así que la tubería mantiene su desempeño por muchos años.'],
  ['Se instala sin complicaciones', 'Es flexible, puede suministrarse en tramos de 100 m y su interior liso deja correr el cableado con facilidad. Resultado: montajes más cortos y menos gasto en obra.'],
  ['Escudo para tus conductores', 'La doble pared forma una barrera frente a golpes y sustancias químicas, y cuida la integridad de toda la instalación.'],
  ['Útil en muchos proyectos', 'Funciona en cableado enterrado y en tubería a la vista, en redes de baja y media tensión de plantas de generación y en telecomunicaciones.']
];

// Detalles de diseño (según la infografía del producto)
const details = [
  ['Encaje con clic', 'La boca acampanada de cada tramo se acopla al siguiente con un clic que lo deja firme en su sitio.'],
  ['Cierre con gomas', 'El extremo de salida lleva anillos de goma que sellan la unión e impiden el paso de agua y suciedad.'],
  ['Interior pulido', 'Las paredes internas son lisas para que el cableado se deslice sin atascarse.'],
  ['Contra el sol y el roce', 'El material soporta la luz solar directa y el desgaste por rozamiento.'],
  ['Muchas medidas', 'Se consigue desde media pulgada hasta ocho pulgadas, según lo que pida tu proyecto.']
];

const productSpecs = [
  ['Material', 'Polietileno de alta densidad (PEAD / HDPE)'],
  ['Construcción', 'Doble pared'],
  ['Interior', 'Pared lisa'],
  ['Presentación', 'Tramos de 100 m'],
  ['Diámetros', 'Desde ½" hasta 8"'],
  ['Coeficiente de fricción', '0,15 a 0,20'],
  ['Unión', 'Campana con clic y gomas de hermeticidad'],
  ['Seguros de sujeción', '4 candados en diámetros de 2" a 8" (50 a 200 mm)']
];

const sectors = [
  'Plantas de generación eléctrica',
  'Redes de telecomunicaciones',
  'Instalaciones comerciales e industriales',
  'Alumbrado público',
  'Desarrollos de vivienda',
  'Parques fotovoltaicos y eólicos'
];

const scenarios = [
  ['Cableado enterrado', 'Canalizaciones en zanja, rellenas con el material excavado o cubiertas con concreto.'],
  ['Tubería a la vista', 'Tramos expuestos que soportan sol, lluvia y roces del entorno.'],
  ['Cambio de aéreo a subterráneo', 'El punto donde el tendido sale del poste y baja al suelo.']
];

const quickFacts = [
  ['PEAD', 'Polietileno de alta densidad'],
  ['Doble pared', 'Interior liso, exterior corrugado'],
  ['½" a 8"', 'Rango de diámetros disponible'],
  ['100 m', 'Longitud de tramo']
];

const presentations = [
  ['Campana con clic', 'Cada tramo entra en el siguiente con un encaje que se traba solo y deja la unión firme.'],
  ['4 seguros de sujeción', 'En diámetros de 2" a 8" (50 a 200 mm), la campana lleva 4 candados repartidos de forma simétrica en su interior.'],
  ['Tramos manejables', 'Se despacha por tramos, lo que simplifica el transporte, el almacenamiento y el avance por frentes de obra.']
];

const steps = [
  ['Preparar la zanja', 'Excava el recorrido y deja una base nivelada, sin piedras ni objetos cortantes.'],
  ['Tender la tubería', 'Coloca los tramos siguiendo el trazado, alineados y bien apoyados.'],
  ['Acoplar', 'Introduce un extremo en la campana del siguiente hasta sentir el clic; las gomas sellan la unión.'],
  ['Pasar los cables', 'Aprovecha el interior liso y su baja fricción para guiar y jalar el cableado con poco esfuerzo.'],
  ['Cubrir', 'Rellena con el material de la excavación o fórmalo en concreto, según el diseño del proyecto.']
];

const faqs = [
  ['¿Sirve solo para redes eléctricas?', 'No. Además de las redes de baja y media tensión, también se usa para alojar el cableado de telecomunicaciones.'],
  ['¿Puedo dejarla a la vista?', 'Sí. Tolera la luz solar y el desgaste por roce, por lo que se usa también en tramos expuestos.'],
  ['¿Se puede enterrar directamente?', 'Sí. Se instala en zanja, con relleno del material excavado o cubierta con concreto.'],
  ['¿En qué diámetros viene?', 'Desde ½" hasta 8". Escríbenos con los datos de tu proyecto y te confirmamos medidas, longitud del tramo y disponibilidad.'],
  ['¿Debo seguir alguna norma al instalarla?', 'Sí. La instalación debe cumplir la norma de instalaciones eléctricas vigente y las indicaciones del fabricante.']
];
---

<Layout
  title="Tubería PEAD (HDPE) en tramos de doble pared — JIMACO"
  description="Tubería PEAD HDPE conduit corrugada de doble pared en tramos, desde ½ hasta 8 pulgadas, para cableado enterrado o a la vista. JIMACO, Bogotá."
>
  <!-- 1. HERO -->
  <section class="relative w-full min-h-[560px] lg:min-h-[640px] overflow-hidden bg-[#0A1A0D] flex items-center">
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-gradient-to-t from-[#0B1E02]/90 via-transparent to-black/20"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-[#0B1E02] via-[#0B1E02]/90 to-[#0B1E02]/60"></div>
      <img
        src="/images/portada/vertical-waves.png"
        alt=""
        class="absolute left-0 bottom-0 h-full w-auto opacity-35 pointer-events-none mix-blend-screen"
      />
    </div>

    <!-- Imagen del producto como fondo -->
    <div class="absolute right-0 top-0 z-[5] hidden lg:block h-full w-[52%] bg-white">
      <img src="/images/fichas/hdpe-tubo.jpg" alt="Tubería PEAD HDPE conduit corrugada de doble pared" class="w-full h-full object-contain p-10" />
      <div class="absolute inset-y-0 left-0 w-1/3 bg-gradient-to-r from-[#0B1E02] to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-[40px] w-full flex flex-col justify-between gap-8 min-h-[560px] lg:min-h-[640px] py-14 sm:py-16">
      <div class="max-w-3xl lg:max-w-[54%] space-y-4 my-auto">
        <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-extrabold text-white tracking-tight leading-[1.08] drop-shadow-xl">
          Tubería <span class="text-[#88D67C]">PEAD</span> (HDPE)
        </h1>

        <div class="flex items-center gap-3 pt-2">
          <span class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-jimaco-orange font-display">
            SUMINISTROS
          </span>
          <span class="w-10 h-[2px] bg-jimaco-orange inline-block"></span>
        </div>

        <p class="text-emerald-100/90 text-base sm:text-xl font-medium tracking-wide pt-1 max-w-2xl">
          El ducto corrugado que lleva tus cables a salvo, bajo tierra o a la vista.
        </p>

        <p class="text-white/80 text-sm sm:text-base leading-relaxed max-w-2xl">
          Conduit de <strong class="text-white">polietileno de alta densidad</strong> con doble pared, en <strong class="text-white">tramos desde ½" hasta 8"</strong>. Una solución robusta para que la energía y las comunicaciones lleguen sin interrupciones.
        </p>

        <ul class="flex flex-wrap gap-2 pt-1">
          {['Soporta sol y desgaste', 'Interior liso para jalar cable', 'Acople con clic y gomas', 'Tramos de ½" a 8"'].map((chip) => (
            <li class="text-[11px] sm:text-xs font-display font-bold uppercase tracking-wider text-white/90 bg-white/10 border border-white/20 backdrop-blur-sm rounded-full px-3.5 py-1.5">
              {chip}
            </li>
          ))}
        </ul>

        <div class="flex flex-wrap gap-3 pt-3">
          <a
            href={WA('Hola JIMACO, quiero cotizar tubería PEAD HDPE conduit corrugada en tramos.')}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-jimaco-orange hover:bg-jimaco-orangeHover text-white font-display font-extrabold uppercase tracking-wider text-xs px-6 py-3.5 rounded-xl shadow-md transition-all"
          >
            Cotizar ahora
          </a>
          <a
            href="#ficha"
            class="border-2 border-white/50 hover:bg-white hover:text-jimaco-dark text-white font-display font-extrabold uppercase tracking-wider text-xs px-6 py-3.5 rounded-xl transition-all"
          >
            Ver ficha técnica
          </a>
        </div>
      </div>

      <div class="flex justify-end pt-4">
        <span class="text-[11px] sm:text-xs font-bold uppercase tracking-widest text-white/80 border border-white/20 bg-black/30 backdrop-blur-md px-4 py-2 rounded-full">
          DOBLE PARED · POLIETILENO DE ALTA DENSIDAD
        </span>
      </div>
    </div>
  </section>

  <!-- 2. FRANJA VERDE -->
  <div class="w-full py-5 sm:py-6 bg-[#063A16] border-t border-b border-black/20 overflow-hidden relative select-none">
    <div class="max-w-7xl mx-auto px-4 sm:px-[40px] flex flex-wrap items-center justify-center sm:justify-between gap-3 text-2xl sm:text-3xl font-display tracking-tight">
      <div class="flex items-center gap-3">
        <span class="text-white/85 font-medium">Cables a salvo,</span>
        <span class="text-[#88D67C] font-extrabold italic">obra más ágil.</span>
      </div>
      <a
        href={WA('Hola JIMACO, quiero cotizar tubería PEAD HDPE conduit corrugada en tramos.')}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-display font-extrabold uppercase tracking-wider bg-jimaco-orange hover:bg-jimaco-orangeHover text-white px-6 py-3 rounded-xl shadow-md transition-all"
      >
        Cotizar por WhatsApp
      </a>
    </div>
  </div>

  <!-- 3. QUÉ ES -->
  <section class="py-14 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-[40px]">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 items-start">
        <div class="lg:col-span-3 space-y-4">
          <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Conoce el producto</span>
          <h2 class="font-display text-2xl sm:text-4xl font-extrabold uppercase text-jimaco-dark">
            Tubería PEAD HDPE conduit corrugada
          </h2>
          <p class="text-sm sm:text-base text-gray-700 leading-relaxed">
            Es un ducto hecho de polietileno de alta densidad (PEAD, o HDPE en inglés), un plástico conocido por ser fuerte y duradero. Está pensado para alojar cables eléctricos tanto bajo tierra como a la intemperie, y los mantiene a salvo de daños para que el servicio de energía no se interrumpa.
          </p>
          <p class="text-sm sm:text-base text-gray-700 leading-relaxed">
            Su perfil corrugado por fuera le da rigidez frente a las cargas, mientras que el interior liso permite que los conductores se deslicen sin enredarse ni rasparse. Se entrega en <strong>tramos</strong> y se une con una boca acampanada de encaje a presión, lo que acelera el trabajo en campo.
          </p>
          <p class="text-sm sm:text-base text-gray-700 leading-relaxed">
            En JIMACO la tenemos disponible <strong>desde ½" hasta 8"</strong>. Si no sabes qué medida o cantidad necesita tu obra, nuestro equipo comercial te ayuda a definirlo.
          </p>
        </div>
        <div class="lg:col-span-2 grid grid-cols-2 gap-3">
          {quickFacts.map(([title, text]) => (
            <div class="bg-emerald-50 border border-emerald-100 rounded-2xl p-5">
              <div class="font-display font-extrabold text-xl text-jimaco-primary leading-tight mb-1">{title}</div>
              <p class="text-xs text-gray-600 leading-snug">{text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 4. INFOGRAFÍA: EL PRODUCTO DE UN VISTAZO -->
  <section class="py-14 sm:py-20 bg-gray-50 border-y border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-[40px] grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-center">
      <div class="order-2 lg:order-1 bg-white rounded-3xl border border-gray-200 shadow-xl p-4 sm:p-6">
        <img
          src="/images/fichas/hdpe-infografia.jpg"
          alt="Tubería PEAD HDPE conduit corrugada: material, campana con clic, gomas de hermeticidad, interior liso, protección UV y diámetros de ½ a 8 pulgadas"
          class="w-full h-auto rounded-2xl"
          loading="lazy"
        />
      </div>
      <div class="order-1 lg:order-2 space-y-5">
        <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">De un vistazo</span>
        <h2 class="font-display text-2xl sm:text-4xl font-extrabold uppercase text-jimaco-dark leading-tight">
          Todo lo que necesitas saber, en una sola imagen
        </h2>
        <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
          Observa el tramo de cerca: la boca acampanada donde encaja el siguiente tramo, las gomas del extremo contrario y el perfil corrugado que lo refuerza. Cada detalle está diseñado para que la instalación sea rápida y la unión quede bien cerrada.
        </p>
        <ul class="space-y-3">
          {[
            'Boca acampanada con encaje a presión',
            'Extremo con gomas que cierran la unión',
            'Interior liso para jalar el cableado',
            'Disponible desde ½" hasta 8"'
          ].map((item) => (
            <li class="flex items-start gap-3 text-sm text-gray-700">
              <span class="mt-0.5 w-5 h-5 rounded-full bg-jimaco-primary text-white text-[11px] font-bold flex items-center justify-center shrink-0">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <div class="flex flex-wrap gap-3 pt-2">
          <a
            href={WA('Hola JIMACO, quiero cotizar tubería PEAD HDPE conduit corrugada en tramos.')}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-jimaco-orange hover:bg-jimaco-orangeHover text-white font-display font-extrabold uppercase tracking-wider text-xs px-6 py-3.5 rounded-xl shadow-md transition-all"
          >
            Solicitar cotización
          </a>
          <a
            href="#ficha"
            class="border-2 border-jimaco-primary/30 hover:border-jimaco-primary text-jimaco-primary font-display font-extrabold uppercase tracking-wider text-xs px-6 py-3.5 rounded-xl transition-all"
          >
            Ver ficha técnica
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. PRESENTACIÓN EN TRAMOS Y MEDIDAS -->
  <section class="py-14 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-[40px]">
      <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Presentación</span>
      <h2 class="font-display text-2xl sm:text-4xl font-extrabold uppercase text-jimaco-dark mb-8">
        Se entrega en tramos
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {presentations.map(([title, text]) => (
          <div class="rounded-3xl border-2 border-jimaco-primary/20 hover:border-jimaco-primary/60 bg-white p-7 sm:p-8 transition-all">
            <h3 class="font-display font-extrabold text-xl text-jimaco-dark mb-2">{title}</h3>
            <p class="text-sm sm:text-base text-gray-600 leading-relaxed">{text}</p>
          </div>
        ))}
      </div>

      <div class="mt-8 rounded-3xl bg-[#0B1E02] text-white p-7 sm:p-10 grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
        <div class="md:col-span-1">
          <span class="text-xs font-extrabold uppercase tracking-widest text-jimaco-orange font-display">Medidas</span>
          <h3 class="font-display text-2xl sm:text-3xl font-extrabold leading-tight mt-1">¿En cuántas pulgadas viene?</h3>
        </div>
        <div class="md:col-span-2 grid grid-cols-2 gap-4">
          <div class="rounded-2xl border border-white/15 bg-white/5 p-5 text-center">
            <div class="font-display text-4xl sm:text-5xl font-extrabold text-[#88D67C]">½&quot;</div>
            <div class="text-xs text-emerald-100/80 mt-1">Medida más pequeña</div>
          </div>
          <div class="rounded-2xl border border-white/15 bg-white/5 p-5 text-center">
            <div class="font-display text-4xl sm:text-5xl font-extrabold text-[#88D67C]">8&quot;</div>
            <div class="text-xs text-emerald-100/80 mt-1">Medida más grande</div>
          </div>
          <p class="col-span-2 text-xs sm:text-sm text-emerald-100/80 leading-relaxed">
            Disponible desde media pulgada hasta ocho pulgadas. Pregúntanos por las medidas intermedias y la disponibilidad de cada una.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. POR QUÉ ELEGIRLA -->
  <section class="py-16 sm:py-24 bg-[#0B1E02] text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-20 pointer-events-none mix-blend-screen">
      <img src="/images/portada/vertical-waves.png" alt="" class="w-full h-full object-cover object-left" />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-[40px] relative z-10 space-y-10 sm:space-y-12">
      <div class="max-w-4xl space-y-4">
        <h2 class="font-display text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight tracking-tight">
          ¿Por qué elegir nuestra <span class="text-[#88D67C] italic">tubería PEAD</span>?
        </h2>
        <p class="text-emerald-100/90 text-sm sm:text-base lg:text-lg leading-relaxed max-w-3xl">
          Es una apuesta segura para que tus instalaciones eléctricas rindan bien hoy y sigan funcionando dentro de muchos años.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {pillars.map(([title, text]) => (
          <div class="rounded-2xl border border-white/15 bg-white/5 backdrop-blur-sm p-6 hover:bg-white/10 hover:border-[#88D67C]/50 transition-all">
            <div class="w-2.5 h-2.5 rounded-full bg-[#FF6A1C] mb-4"></div>
            <h3 class="font-display font-extrabold text-lg text-white mb-2">{title}</h3>
            <p class="text-sm text-emerald-100/80 leading-relaxed">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. FICHA TÉCNICA -->
  <section id="ficha" class="scroll-mt-24 py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-[40px]">
      <div class="mb-8">
        <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Ficha técnica</span>
        <h2 class="font-display text-2xl sm:text-4xl font-extrabold uppercase text-jimaco-dark">
          Especificaciones del producto
        </h2>
        <p class="text-sm sm:text-base text-gray-600 mt-3 max-w-3xl leading-relaxed">
          Tubería conduit corrugada de doble pared, fabricada con polietileno de alta densidad (PEAD). Se presenta en tramos y sirve para sistemas eléctricos subterráneos y expuestos.
        </p>
      </div>

      <article class="grid grid-cols-1 lg:grid-cols-2 gap-0 items-stretch bg-gray-50 border border-gray-200 rounded-3xl overflow-hidden">
        <div class="bg-white p-8 sm:p-12 flex items-center justify-center border-b lg:border-b-0 lg:border-r border-gray-200">
          <img
            src="/images/fichas/hdpe-tubo.jpg"
            alt="Tubería PEAD HDPE en tramos"
            class="max-h-[420px] w-auto object-contain"
            loading="lazy"
          />
        </div>
        <div class="p-6 sm:p-10">
          <h3 class="font-display font-extrabold text-xs uppercase tracking-wider text-jimaco-primary mb-3">Datos del producto</h3>
          <dl class="divide-y divide-gray-200 border-y border-gray-200 text-sm mb-6">
            {productSpecs.map(([k, v]) => (
              <div class="flex justify-between gap-4 py-2.5">
                <dt class="text-gray-500">{k}</dt>
                <dd class="font-bold text-jimaco-dark text-right">{v}</dd>
              </div>
            ))}
          </dl>
          <div class="flex flex-wrap gap-3">
            <a
              href={WA('Hola JIMACO, quiero cotizar tubería PEAD HDPE conduit corrugada en tramos.')}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-jimaco-orange hover:bg-jimaco-orangeHover text-white font-display font-extrabold uppercase tracking-wider text-xs px-6 py-3.5 rounded-xl shadow-md transition-all"
            >
              Solicitar cotización
            </a>
            <a
              href="/catalogo"
              class="border-2 border-jimaco-primary/30 hover:border-jimaco-primary text-jimaco-primary font-display font-extrabold uppercase tracking-wider text-xs px-6 py-3.5 rounded-xl transition-all"
            >
              Ver catálogo
            </a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- 7b. ENTREGAS REALES -->
  <EntregasCarousel
    eyebrow="Evidencia en campo"
    heading="Entregas"
    headingAccent="reales"
    intro="Así despachamos y descargamos nuestra tubería PEAD HDPE en tramos: lista para llegar a tu obra."
    badge="Entrega real"
    photos={[
      { src: '/images/entregas/tramos-pila-patio.jpg', alt: 'Pila de tramos de tubería PEAD HDPE roja en patio de almacenamiento', caption: 'Tramos de tubería PEAD HDPE listos para despacho' },
      { src: '/images/entregas/tramos-descarga-camion.jpg', alt: 'Operarios descargando tramos de tubería PEAD HDPE roja de un camión', caption: 'Descarga de tramos desde el camión' },
      { src: '/images/entregas/tramos-descarga-obra.jpg', alt: 'Operarios manipulando tramos de tubería PEAD HDPE roja en obra', caption: 'Manejo de tramos en obra' },
      { src: '/images/entregas/tramos-contenedor-patio.jpg', alt: 'Contenedor abierto con tramos de tubería PEAD HDPE roja', caption: 'Despacho en contenedor' },
      { src: '/images/entregas/tramos-contenedor-frontal.jpg', alt: 'Contenedor lleno de tramos de tubería PEAD HDPE roja vista frontal', caption: 'Contenedor completo de tramos, organizado para el transporte' },
      { src: '/images/entregas/tramos-acopio-edificio.jpg', alt: 'Tramos de tubería PEAD HDPE roja almacenados junto a un edificio', caption: 'Tramos almacenados, listos para su entrega' },
      { src: '/images/entregas/tramos-acopio-patio.jpg', alt: 'Tramos de tubería PEAD HDPE roja en patio de almacenamiento', caption: 'Tramos en patio, de diferentes diámetros' },
      { src: '/images/entregas/tramos-rollos-rojos.jpg', alt: 'Rollos de tubería PEAD HDPE roja apilados', caption: 'Tubería PEAD HDPE en rollos' },
