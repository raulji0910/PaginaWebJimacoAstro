---
import Layout from '../../layouts/Layout.astro';
import SuministrosSection from '../../components/SuministrosSection.astro';
---

<Layout title="Suministros Industriales" description="Catálogo de suministros para energía solar, construcción y protección personal en Colombia.">
  <div class="bg-jimaco-primary text-white py-16 text-center">
    <div class="max-w-4xl mx-auto px-4 space-y-3">
      <span class="text-xs uppercase tracking-widest text-jimaco-accent font-bold">Catálogo Oficial</span>
      <h1 class="font-display text-4xl sm:text-5xl font-extrabold">Líneas de Suministros Técnicos</h1>
      <p class="text-emerald-100 text-base sm:text-lg">Productos importados y certificados para proyectos de cualquier envergadura.</p>
    </div>
  </div>

  <SuministrosSection />
</Layout>
