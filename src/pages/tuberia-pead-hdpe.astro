---
import Layout from '../layouts/Layout.astro';
import EntregasCarousel from '../components/EntregasCarousel.astro';

const WA = (text: string) => `https://wa.me/573123503397?text=${encodeURIComponent(text)}`;

const highlights = [
  ['Doble pared', 'Interior liso, exterior corrugado.'],
  ['A prueba del entorno', 'Humedad, químicos del suelo y rayos UV.'],
  ['Fácil de cablear', 'Fricción baja, de 0,15 a 0,20.'],
  ['Unión segura', 'Espiga-campana con empaque elastomérico.']
];

const features = [
  ['Doble pared, mejor desempeño', 'La pared interior lisa y la exterior corrugada mejoran su respuesta al aplastamiento, al impacto y a la rigidez.'],
  ['Hecha para durar', 'Resiste la humedad, los agentes químicos y corrosivos del suelo y los rayos ultravioleta, así que conserva sus propiedades mucho tiempo después de instalada.'],
  ['Cableado más fácil', 'Su coeficiente de fricción es bajo (entre 0,15 y 0,20), y los cables se deslizan con menos esfuerzo.'],
  ['Unión rápida y hermética', 'El sistema espiga-campana ajusta de forma segura, y la espiga incluye un empaque elastomérico.'],
  ['Mayor sujeción en diámetros grandes', 'De 50 a 200 mm (2 a 8 pulgadas), la campana trae 4 seguros (candados) distribuidos simétricamente por dentro.']
];

const productSpecs = [
  ['Material', 'Polietileno virgen de alta densidad (PEAD)'],
  ['Construcción', 'Doble pared'],
  ['Exterior', 'Corrugado, color negro'],
  ['Interior', 'Pared lisa'],
  ['Presentación', 'Rollo'],
  ['Coeficiente de fricción', '0,15 a 0,20'],
  ['Unión', 'Espiga-campana con empaque elastomérico'],
  ['Seguros de sujeción', '4 candados en diámetros de 50 a 200 mm (2 a 8")']
];

const sectors = [
  'Instalaciones comerciales e industriales',
  'Alumbrado público',
  'Desarrollos de vivienda',
  'Parques logísticos e industriales',
  'Hotelería',
  'Parques fotovoltaicos y eólicos'
];

const scenarios = [
  ['Transiciones aéreo-subterráneas', 'Para pasar del tendido aéreo a la canalización subterránea.'],
  ['Redes a la intemperie', 'Sistemas eléctricos expuestos que necesitan resistir sol y humedad.'],
  ['Zanja a cielo abierto', 'Redes subterráneas rellenas con el material de la excavación o encofradas en concreto.']
];

const quickFacts = [
  ['PEAD', 'Polietileno de alta densidad'],
  ['Doble pared', 'Interior liso, exterior corrugado'],
  ['BT y MT', 'Sistemas de baja y media tensión'],
  ['Aéreo y subterráneo', 'Transiciones, intemperie y zanja']
];

const materialBenefits = [
  ['Liviana y fácil de transportar', 'El polietileno pesa poco frente a otros materiales de canalización, lo que facilita el manejo y el tendido en obra.'],
  ['Flexible', 'Se adapta a los cambios de dirección suaves del trazado, así que reduce la necesidad de accesorios en muchos recorridos.'],
  ['No se oxida ni se corroe', 'No se degrada con la humedad ni con los agentes corrosivos del suelo, a diferencia de los materiales metálicos.'],
  ['Aislante eléctrico', 'Al ser un plástico no conductor, aporta una capa adicional de seguridad alrededor de los cables.'],
  ['Menos uniones', 'En presentación continua se necesitan menos empalmes, y cada unión que se evita es un punto menos donde pueden entrar humedad o suciedad.'],
  ['Negro con protección UV', 'El tono negro y la estabilización del material están pensados para soportar la exposición al sol en redes a la intemperie.']
];

const presentations = [
  ['Ideal para tendidos largos', 'Al desenrollarse como una sola pieza continua, reduce el número de uniones y agiliza la instalación.'],
  ['Se adapta al trazado', 'Su flexibilidad permite seguir curvas suaves del recorrido sin tantos accesorios.'],
  ['Unión segura cuando se necesita', 'Para empalmar, el sistema espiga-campana ofrece una unión firme y hermética, con empaque elastomérico y, en diámetros de 50 a 200 mm, 4 seguros de sujeción.']
];

const steps = [
  ['Preparar la zanja', 'Excava el recorrido y deja una base nivelada y libre de piedras o elementos cortantes.'],
  ['Tender la tubería', 'Desenrolla el rollo siguiendo el trazado, evitando torcerla, arrastrarla o doblarla de forma brusca.'],
  ['Unir y sellar', 'Si necesitas empalmar, encaja la espiga en la campana con su empaque elastomérico hasta que quede firme.'],
  ['Pasar los cables', 'Aprovecha la pared interior lisa y su baja fricción para guiar y jalar el cableado con menos esfuerzo.'],
  ['Rellenar o encofrar', 'Cubre con el material de la excavación o encofra en concreto, según el diseño de tu proyecto.']
];

const faqs = [
  ['¿Sirve solo para redes eléctricas?', 'No. Además de los sistemas eléctricos de baja y media tensión, la tubería PEAD es un elemento clave en las redes de telecomunicaciones.'],
  ['¿Puede quedar a la intemperie?', 'Sí. Resiste los rayos ultravioleta y la humedad, y por eso se usa en transiciones aéreo-subterráneas y en redes expuestas.'],
  ['¿Se puede enterrar directamente en zanja?', 'Sí. Se instala en canalizaciones a cielo abierto, rellenas con el material de la excavación o encofradas en concreto.'],
  ['¿Qué diámetros y longitudes manejan?', 'Escríbenos con los datos de tu proyecto y te confirmamos las medidas y la disponibilidad.'],
  ['¿Debo seguir alguna norma al instalarla?', 'Sí. La instalación debe hacerse conforme a la norma de instalaciones eléctricas vigente y a las indicaciones del fabricante.']
];
---

<Layout
  title="Tubería PEAD HDPE de doble pared — JIMACO"
  description="Tubería PEAD Conduit corrugada de doble pared para sistemas eléctricos aéreos y subterráneos de baja y media tensión. JIMACO, Bogotá."
>
  <!-- 1. HERO -->
  <section class="relative w-full min-h-[560px] lg:min-h-[640px] overflow-hidden bg-[#0A1A0D] flex items-center">
    <div class="absolute inset-0 z-0">
      <img
        src="/images/pead/hero-tuberia-pead.jpg"
        alt=""
        class="absolute right-0 top-0 h-full w-full lg:w-3/5 object-cover object-center opacity-60 lg:opacity-100"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#0B1E02] via-[#0B1E02]/85 to-[#0B1E02]/20"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#0B1E02]/90 via-transparent to-black/20"></div>
      <img
        src="/images/vertical-waves.png"
        alt=""
        class="absolute left-0 bottom-0 h-full w-auto opacity-35 pointer-events-none mix-blend-screen"
      />
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-[40px] w-full flex flex-col justify-between gap-8 min-h-[560px] lg:min-h-[640px] py-14 sm:py-16">
      <div class="max-w-3xl space-y-4 my-auto">
        <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-extrabold text-white tracking-tight leading-[1.08] drop-shadow-xl">
          Tubería <span class="text-[#88D67C]">PEAD</span> HDPE
        </h1>

        <div class="flex items-center gap-3 pt-2">
          <span class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-jimaco-orange font-display">
            SUMINISTROS
          </span>
          <span class="w-10 h-[2px] bg-jimaco-orange inline-block"></span>
        </div>

        <p class="text-emerald-100/90 text-base sm:text-xl font-medium tracking-wide pt-1 max-w-2xl">
          Protege tu cableado, desde la zanja hasta el poste.
        </p>

        <p class="text-white/80 text-sm sm:text-base leading-relaxed max-w-2xl">
          Tubería conduit corrugada de <strong class="text-white">doble pared</strong>, fabricada en polietileno virgen de alta densidad. Por fuera es negra y corrugada, y por dentro tiene una pared lisa que facilita el paso de los cables. Es la solución para canalizar y proteger redes eléctricas de baja y media tensión y de telecomunicaciones, tanto aéreas como subterráneas.
        </p>

        <ul class="flex flex-wrap gap-2 pt-1">
          {['Resistente a humedad y rayos UV', 'Baja fricción: 0,15 a 0,20', 'Unión espiga-campana hermética', 'Presentación en rollo negro'].map((chip) => (
            <li class="text-[11px] sm:text-xs font-display font-bold uppercase tracking-wider text-white/90 bg-white/10 border border-white/20 backdrop-blur-sm rounded-full px-3.5 py-1.5">
              {chip}
            </li>
          ))}
        </ul>

        <div class="flex flex-wrap gap-3 pt-3">
          <a
            href={WA('Hola JIMACO, quiero cotizar tubería PEAD HDPE de doble pared.')}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-jimaco-orange hover:bg-jimaco-orangeHover text-white font-display font-extrabold uppercase tracking-wider text-xs px-6 py-3.5 rounded-xl shadow-md transition-all"
          >
            Cotizar ahora
          </a>
          <a
            href="#ficha"
            class="border-2 border-white/50 hover:bg-white hover:text-jimaco-dark text-white font-display font-extrabold uppercase tracking-wider text-xs px-6 py-3.5 rounded-xl transition-all"
          >
            Ver ficha técnica
          </a>
        </div>
      </div>

      <div class="flex justify-end pt-4">
        <span class="text-[11px] sm:text-xs font-bold uppercase tracking-widest text-white/80 border border-white/20 bg-black/30 backdrop-blur-md px-4 py-2 rounded-full">
          DOBLE PARED · POLIETILENO DE ALTA DENSIDAD
        </span>
      </div>
    </div>
  </section>

  <!-- 2. FRANJA VERDE -->
  <div class="w-full py-5 sm:py-6 bg-[#063A16] border-t border-b border-black/20 overflow-hidden relative select-none">
    <div class="max-w-7xl mx-auto px-4 sm:px-[40px] flex flex-wrap items-center justify-center sm:justify-between gap-3 text-2xl sm:text-3xl font-display tracking-tight">
      <div class="flex items-center gap-3">
        <span class="text-white/85 font-medium">Protección que llega</span>
        <span class="text-[#88D67C] font-extrabold italic">hasta el último cable.</span>
      </div>
      <a
        href={WA('Hola JIMACO, quiero cotizar tubería PEAD HDPE de doble pared.')}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-display font-extrabold uppercase tracking-wider bg-jimaco-orange hover:bg-jimaco-orangeHover text-white px-6 py-3 rounded-xl shadow-md transition-all"
      >
        Cotizar por WhatsApp
      </a>
    </div>
  </div>

  <!-- 2b. QUÉ ES LA TUBERÍA PEAD -->
  <section class="py-14 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-[40px]">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 items-start">
        <div class="lg:col-span-3 space-y-4">
          <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Conoce el producto</span>
          <h2 class="font-display text-2xl sm:text-4xl font-extrabold uppercase text-jimaco-dark">
            ¿Qué es la tubería PEAD (HDPE)?
          </h2>
          <p class="text-sm sm:text-base text-gray-700 leading-relaxed">
            PEAD son las siglas de polietileno de alta densidad (HDPE, en inglés): un plástico resistente y flexible muy usado para proteger y conducir cables. En una instalación eléctrica funciona como un ducto: aloja los conductores, los protege de golpes, humedad y agentes del terreno, y permite cambiarlos o ampliarlos sin tener que abrir de nuevo la zanja.
          </p>
          <p class="text-sm sm:text-base text-gray-700 leading-relaxed">
            Nuestra tubería conduit corrugada es de <strong>doble pared</strong>: la pared exterior corrugada aporta resistencia al aplastamiento, al impacto y rigidez, mientras que la pared interior lisa facilita el paso del cableado. Por eso es una de las soluciones más usadas en redes eléctricas y de telecomunicaciones, tanto aéreas como subterráneas.
          </p>
          <p class="text-sm sm:text-base text-gray-700 leading-relaxed">
            En JIMACO la suministramos en <strong>rollo negro</strong>. Si no sabes qué medida o cantidad necesita tu obra, nuestro equipo comercial te asesora.
          </p>
        </div>
        <div class="lg:col-span-2 grid grid-cols-2 gap-3">
          {quickFacts.map(([title, text]) => (
            <div class="bg-emerald-50 border border-emerald-100 rounded-2xl p-5">
              <div class="font-display font-extrabold text-xl text-jimaco-primary leading-tight mb-1">{title}</div>
              <p class="text-xs text-gray-600 leading-snug">{text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 2c. VENTAJAS DEL MATERIAL -->
  <section class="py-14 sm:py-20 bg-gray-50 border-y border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-[40px]">
      <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Ventajas del material</span>
      <h2 class="font-display text-2xl sm:text-4xl font-extrabold uppercase text-jimaco-dark mb-8">
        Por qué el PEAD es tan usado en canalizaciones
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {materialBenefits.map(([title, text]) => (
          <div class="bg-white rounded-2xl border border-gray-200/80 p-6 shadow-xs hover:shadow-lg hover:border-jimaco-primary/40 transition-all">
            <h3 class="font-display font-bold text-base text-jimaco-primary mb-1">{title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2d. PRESENTACIÓN EN ROLLO -->
  <section class="py-14 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-[40px]">
      <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Presentaciones</span>
      <h2 class="font-display text-2xl sm:text-4xl font-extrabold uppercase text-jimaco-dark mb-8">
        Presentación en rollo negro
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {presentations.map(([title, text]) => (
          <div class="rounded-3xl border-2 border-jimaco-primary/20 hover:border-jimaco-primary/60 bg-white p-7 sm:p-8 transition-all">
            <h3 class="font-display font-extrabold text-xl text-jimaco-dark mb-2">{title}</h3>
            <p class="text-sm sm:text-base text-gray-600 leading-relaxed">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. ¿POR QUÉ ELEGIR NUESTRA TUBERÍA PEAD? -->
  <section class="py-16 sm:py-24 bg-[#0B1E02] text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-20 pointer-events-none mix-blend-screen">
      <img src="/images/vertical-waves.png" alt="" class="w-full h-full object-cover object-left" />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-[40px] relative z-10 space-y-10 sm:space-y-12">
      <div class="max-w-4xl space-y-4">
        <h2 class="font-display text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight tracking-tight">
          ¿Por qué elegir nuestra <span class="text-[#88D67C] italic">tubería PEAD</span>?
        </h2>
        <p class="text-emerald-100/90 text-sm sm:text-base lg:text-lg leading-relaxed max-w-3xl">
          La tubería PEAD Conduit corrugada de transición protege tus cables y mantiene tu sistema eléctrico funcionando de forma segura y estable, tanto en obras aéreas como subterráneas.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {highlights.map(([title, text]) => (
          <div class="rounded-2xl border border-white/15 bg-white/5 backdrop-blur-sm p-6 hover:bg-white/10 hover:border-[#88D67C]/50 transition-all">
            <div class="w-2.5 h-2.5 rounded-full bg-[#FF6A1C] mb-4"></div>
            <h3 class="font-display font-extrabold text-lg text-white mb-1">{title}</h3>
            <p class="text-sm text-emerald-100/80 leading-relaxed">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. DESCRIPCIÓN Y FICHA -->
  <section id="ficha" class="scroll-mt-24 py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-[40px]">
      <div class="mb-8">
        <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Descripción</span>
        <h2 class="font-display text-2xl sm:text-4xl font-extrabold uppercase text-jimaco-dark">
          Tubería Conduit corrugada de doble pared
        </h2>
        <p class="text-sm sm:text-base text-gray-600 mt-3 max-w-3xl leading-relaxed">
          Tubería conduit corrugada de doble pared, fabricada con polietileno virgen de alta densidad (PEAD). Por fuera es negra y corrugada, y por dentro tiene una pared lisa. Se presenta en rollo y sirve para sistemas eléctricos aéreos y subterráneos.
        </p>
      </div>

      <article class="grid grid-cols-1 lg:grid-cols-2 gap-0 items-stretch bg-gray-50 border border-gray-200 rounded-3xl overflow-hidden">
        <div class="bg-white p-8 sm:p-12 flex items-center justify-center border-b lg:border-b-0 lg:border-r border-gray-200">
          <img
            src="/images/pead/rollo-tuberia-pead-negra.jpg"
            alt="Tubería PEAD corrugada de doble pared"
            class="max-h-80 w-auto object-contain"
            loading="lazy"
          />
        </div>
        <div class="p-6 sm:p-10">
          <h3 class="font-display font-extrabold text-xs uppercase tracking-wider text-jimaco-primary mb-3">Ficha técnica</h3>
          <dl class="divide-y divide-gray-200 border-y border-gray-200 text-sm mb-6">
            {productSpecs.map(([k, v]) => (
              <div class="flex justify-between gap-4 py-2.5">
                <dt class="text-gray-500">{k}</dt>
                <dd class="font-bold text-jimaco-dark text-right">{v}</dd>
              </div>
            ))}
          </dl>
          <div class="flex flex-wrap gap-3">
            <a
              href={WA('Hola JIMACO, quiero cotizar la tubería PEAD Conduit corrugada de doble pared.')}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-jimaco-orange hover:bg-jimaco-orangeHover text-white font-display font-extrabold uppercase tracking-wider text-xs px-6 py-3.5 rounded-xl shadow-md transition-all"
            >
              Solicitar cotización
            </a>
            <a
              href="/catalogo"
              class="border-2 border-jimaco-primary/30 hover:border-jimaco-primary text-jimaco-primary font-display font-extrabold uppercase tracking-wider text-xs px-6 py-3.5 rounded-xl transition-all"
            >
              Ver catálogo
            </a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- 4b. ENTREGAS REALES -->
  <EntregasCarousel />

  <!-- 5. CARACTERÍSTICAS -->
  <section class="py-16 sm:py-20 bg-gray-50 border-y border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-[40px]">
      <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Características</span>
      <h2 class="font-display text-2xl sm:text-4xl font-extrabold uppercase text-jimaco-dark mb-8">
        Pensada para rendir en obra
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {features.map(([title, text], i) => (
          <div class="bg-white rounded-2xl border border-gray-200/80 p-6 shadow-xs hover:shadow-lg hover:border-jimaco-primary/40 transition-all">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-jimaco-primary flex items-center justify-center font-display font-extrabold mb-4">
              {i + 1}
            </div>
            <h3 class="font-display font-bold text-base text-jimaco-primary mb-1">{title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. APLICACIONES -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-[40px] space-y-12">
      <div>
        <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Aplicaciones</span>
        <h2 class="font-display text-2xl sm:text-4xl font-extrabold uppercase text-jimaco-dark mb-3">
          ¿Dónde se instala?
        </h2>
        <p class="text-sm sm:text-base text-gray-600 max-w-3xl leading-relaxed mb-8">
          Es ideal en transiciones aéreo-subterráneas y en redes expuestas a la intemperie. También sirve en redes subterráneas hechas en zanja a cielo abierto. Se usa en sistemas eléctricos de baja y media tensión, y se instala conforme a la norma de instalaciones eléctricas.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {scenarios.map(([title, text]) => (
            <div class="bg-gray-50 rounded-2xl border border-gray-200 p-6">
              <h3 class="font-display font-bold text-base text-jimaco-primary mb-1">{title}</h3>
              <p class="text-sm text-gray-600 leading-relaxed">{text}</p>
            </div>
          ))}
        </div>
      </div>

      <div>
        <h3 class="font-display font-extrabold text-sm uppercase tracking-wider text-jimaco-dark mb-4">
          Sectores donde se usa
        </h3>
        <div class="flex flex-wrap gap-3">
          {sectors.map((s) => (
            <span class="bg-emerald-50 text-jimaco-primary border border-emerald-100 rounded-full px-4 py-2 text-xs font-display font-bold uppercase tracking-wider">
              {s}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 6b. INSTALACIÓN Y PREGUNTAS FRECUENTES -->
  <section class="py-16 sm:py-20 bg-gray-50 border-y border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-[40px] space-y-14">
      <div>
        <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Instalación</span>
        <h2 class="font-display text-2xl sm:text-4xl font-extrabold uppercase text-jimaco-dark mb-2">Así se instala, paso a paso</h2>
        <p class="text-sm text-gray-600 mb-8 max-w-3xl">Guía general de referencia. Sigue siempre la norma de instalaciones eléctricas vigente y las indicaciones del fabricante.</p>
        <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
          {steps.map(([title, text], i) => (
            <li class="bg-white rounded-2xl border border-gray-200/80 p-5 shadow-xs">
              <div class="w-9 h-9 rounded-full bg-jimaco-orange text-white font-display font-extrabold flex items-center justify-center mb-3">{i + 1}</div>
              <h3 class="font-display font-bold text-sm text-jimaco-primary mb-1">{title}</h3>
              <p class="text-xs text-gray-600 leading-relaxed">{text}</p>
            </li>
          ))}
        </ol>
      </div>

      <div>
        <span class="text-xs font-bold text-gray-500 uppercase tracking-wider">Resolvemos tus dudas</span>
        <h2 class="font-display text-2xl sm:text-4xl font-extrabold uppercase text-jimaco-dark mb-6">Preguntas frecuentes</h2>
        <div class="space-y-3 max-w-4xl">
          {faqs.map(([q, a]) => (
            <details class="group bg-white rounded-2xl border border-gray-200/80 p-5 open:shadow-md">
              <summary class="cursor-pointer list-none flex items-center justify-between gap-4 font-display font-bold text-base text-jimaco-dark">
                {q}
                <span class="text-jimaco-orange text-xl transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="text-sm text-gray-600 leading-relaxed mt-3">{a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 7. SOSTENIBILIDAD -->
  <section class="py-12 sm:py-14 bg-[#063A16] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-[40px] grid grid-cols-1 lg:grid-cols-3 gap-6 items-center">
      <div class="lg:col-span-2">
        <span class="text-xs font-extrabold uppercase tracking-widest text-jimaco-orange font-display">Compromiso con el medio ambiente</span>
        <p class="font-display text-xl sm:text-2xl font-bold leading-snug mt-2">
          Nuestro proceso de producción busca reducir el impacto ecológico y ofrecerte una solución más sostenible para tus proyectos.
        </p>
      </div>
      <p class="text-emerald-100/90 text-sm leading-relaxed lg:border-l lg:border-white/20 lg:pl-6">
        La tubería PEAD (HDPE) es un elemento clave en la construcción de redes eléctricas y de telecomunicaciones.
      </p>
    </div>
  </section>

  <!-- 8. CTA FINAL -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-[40px]">
      <div class="bg-[#0B1E02] rounded-3xl text-white px-6 sm:px-12 py-12 sm:py-16 grid grid-cols-1 lg:grid-cols-3 gap-8 items-center">
        <div class="lg:col-span-2 space-y-3">
          <h2 class="font-display text-3xl sm:text-5xl font-extrabold leading-tight">
            ¿Tienes un proyecto <span class="text-[#88D67C] italic">eléctrico</span>?
          </h2>
          <p class="text-emerald-100/90 text-sm sm:text-base max-w-2xl">
            Cuéntanos tu obra y te ayudamos a elegir diámetros y cantidades. Atendemos proyectos en todo Colombia.
          </p>
        </div>
        <div class="flex flex-col gap-3">
          <a
            href={WA('Hola JIMACO, necesito asesoría para tubería PEAD HDPE.')}
            target="_blank"
            rel="noopener noreferrer"
            class="text-center bg-jimaco-orange hover:bg-jimaco-orangeHover text-white font-display font-extrabold uppercase tracking-wider text-xs px-6 py-3.5 rounded-xl shadow-md transition-all"
          >
            Hablar con un asesor
          </a>
          <a
            href="mailto:ventas@jimaco.com.co?subject=Cotización tubería PEAD"
            class="text-center border-2 border-white/40 hover:bg-white hover:text-jimaco-dark text-white font-display font-extrabold uppercase tracking-wider text-xs px-6 py-3.5 rounded-xl transition-all"
          >
            ventas@jimaco.com.co
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
