---
import Layout from '../layouts/Layout.astro';
import HeroSlider from '../components/HeroSlider.astro';
import SupplyThreeBoxes from '../components/SupplyThreeBoxes.astro';
import SuministrosHeaderNumber from '../components/SuministrosHeaderNumber.astro';
import HorizontalSuppliesCarousels from '../components/HorizontalSuppliesCarousels.astro';
import NuestraEsencia from '../components/NuestraEsencia.astro';
import LlegandoLejosMap from '../components/LlegandoLejosMap.astro';
import GalleryScrollBanner from '../components/GalleryScrollBanner.astro';
import HistoryFeriaSection from '../components/HistoryFeriaSection.astro';
import PortafolioSolutionsSection from '../components/PortafolioSolutionsSection.astro';
import ThreeProjectsJoinedGallery from '../components/ThreeProjectsJoinedGallery.astro';
import ProjectsShowcase from '../components/ProjectsShowcase.astro';
import SloganBanner from '../components/SloganBanner.astro';
import MetricsGrowth from '../components/MetricsGrowth.astro';
import CommercialTeamBanner from '../components/CommercialTeamBanner.astro';
import BrandLogosBorderGrid from '../components/BrandLogosBorderGrid.astro';
---

<Layout title="Inicio — Soluciones Industriales que Impulsan el Futuro">
  <!-- 1. Hero Slider Revolution (ExpoSolar 2026 / Soluciones industriales / Energía limpia / Talento humano) -->
  <HeroSlider />

  <!-- 2. Three Overlapping Highlight Cards -->
  <SupplyThreeBoxes />

  <!-- 3. Header "+1.260 Productos / Tres líneas, una misma promesa" -->
  <SuministrosHeaderNumber />

  <!-- 4. Interactive Horizontal Supplies Carousels (Green & Yellow & Dark Boxes) -->
  <HorizontalSuppliesCarousels />

  <!-- 5. Nuestra Esencia / Panorámica del Campo Parex + Marquee Ticker (Screenshot 1 & 2) -->
  <NuestraEsencia />

  <!-- 6. Llegando Lejos / Mapa de Colombia (+460 Clientes satisfechos) (Screenshot 3) -->
  <LlegandoLejosMap />

  <!-- 7. Animated Square Products Gallery Banner (Screenshot 4) -->
  <GalleryScrollBanner />

  <!-- 8. Historia & Fundada en 2013 (Feria Solar) -->
  <HistoryFeriaSection />

  <!-- 9. Ticker Asesoría • Eficiencia • Cumplimiento + Portafolio de Soluciones (Screenshot 5) -->
  <PortafolioSolutionsSection />

  <!-- 10. Three Projects Joined Panoramic Gallery (Screenshot 6: Solar farm / Construction slab / Galvanized pipes) -->
  <ThreeProjectsJoinedGallery />

  <!-- 11. Projects Showcase (En los proyectos más destacados - Celsia Flandes, Dulima, Yuma) -->
  <ProjectsShowcase />

  <!-- 12. Giant Slogan Banner ("Engranando futuro juntos") -->
  <SloganBanner />

  <!-- 13. Growth Metrics (+10 años / +350 clientes / +1250 productos) -->
  <MetricsGrowth />

  <!-- 14. Commercial Team Banner with Real Photo ("¿Buscas un aliado estratégico...?") -->
  <CommercialTeamBanner />

  <!-- 15. Clean Brand Logos with 1px Divider Grid -->
  <BrandLogosBorderGrid />
</Layout>
