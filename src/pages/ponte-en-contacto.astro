---
import Layout from '../layouts/Layout.astro';
import BrandLogosBorderGrid from '../components/BrandLogosBorderGrid.astro';
---

<Layout 
  title="Ponte en Contacto — JIMACO"
  description="Contáctanos para cotizaciones y asesoría en suministros para energía solar, construcción y protección personal en Colombia. Teléfonos: +57 601 3782933, +57 312 3503397."
>

  <!-- 1. Hero Section with Background Image (Workers with Helmets under Blue Sky) -->
  <section class="relative w-full h-[480px] sm:h-[540px] lg:h-[600px] overflow-hidden bg-[#0A1A0D] flex items-center">
    
    <!-- Background Photo: bg-hero-contacto-1.jpg -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/bg-hero-contacto-1.jpg"
        alt="Ponte en Contacto JIMACO"
        class="w-full h-full object-cover object-center"
      />

      <!-- Gradient Overlays & Contour Wave Graphic -->
      <div class="absolute inset-0 bg-gradient-to-r from-[#0B1E02]/90 via-[#0B1E02]/50 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#0B1E02]/80 via-transparent to-transparent"></div>
      
      <!-- Green Contour Wave Overlay -->
      <img
        src="/images/vertical-waves.png"
        alt=""
        class="absolute left-0 bottom-0 h-full w-auto opacity-35 pointer-events-none mix-blend-screen"
      />
    </div>

    <!-- Hero Content (Left Aligned matching jimaco-local) -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-8 w-full flex flex-col justify-center h-full py-16">
      <div class="max-w-3xl space-y-4">
        
        <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-extrabold text-white tracking-tight leading-[1.08] drop-shadow-xl">
          Hablemos <span class="text-[#88D67C]">de</span><br />
          tu próximo proyecto
        </h1>

        <div class="flex items-center gap-3 pt-2">
          <span class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-jimaco-orange font-display">
            CONTACTO
          </span>
          <span class="w-10 h-[2px] bg-jimaco-orange inline-block"></span>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. Main Contact Section: Interactive Map + Official Contact Cards -->
  <section class="py-16 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Left Column: Google Maps Interactive Embed -->
      <div class="lg:col-span-6 h-full min-h-[400px] sm:min-h-[480px] lg:min-h-[580px] rounded-3xl overflow-hidden shadow-2xl border-4 border-gray-100 bg-gray-100 relative">
        <iframe
          src="https://maps.google.com/maps?q=Cl.+23+%2325-06,+Samper+Mendoza,+Bogot%C3%A1&t=&z=16&ie=UTF8&iwloc=&output=embed"
          width="100%"
          height="100%"
          style="border:0; min-height: 480px;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full h-full"
          title="Ubicación Sede Principal JIMACO Bogotá"
        ></iframe>
      </div>

      <!-- Right Column: Tag, Headline, Text, Address, Emails, Phones, Socials -->
      <div class="lg:col-span-6 space-y-8">
        
        <!-- Tag & Title -->
        <div class="space-y-4">
          <div class="flex items-center gap-2">
            <span class="text-xs font-extrabold uppercase tracking-widest text-[#FF6A1C] font-display">
              CONTÁCTANOS AHORA
            </span>
            <span class="w-8 h-[2px] bg-[#FF6A1C] inline-block"></span>
          </div>

          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0B1E02] leading-tight tracking-tight">
            Estaremos felices de resolver todas tus dudas
          </h2>

          <p class="text-gray-600 text-sm sm:text-base leading-relaxed text-pretty">
            Nuestro equipo comercial está listo para atender tus requerimientos y brindarte una solución integral adaptada a tu industria.
          </p>
        </div>

        <!-- Contact Blocks Grid -->
        <div class="space-y-6 pt-2">
          
          <!-- Sede Principal -->
          <div class="space-y-2 border-b border-gray-100 pb-5">
            <span class="text-xs font-extrabold uppercase tracking-widest text-[#1C6521] font-display">
              SEDE PRINCIPAL
            </span>
            <div class="flex items-center gap-3 pt-1">
              <div class="w-9 h-9 rounded-full bg-emerald-50 text-[#1C6521] flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[#88D67C]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <p class="font-display font-medium text-sm sm:text-base text-gray-800">
                Cl. 23 #25-06. Samper Mendoza, Bogotá.
              </p>
            </div>
          </div>

          <!-- Correos Electrónicos -->
          <div class="space-y-2 border-b border-gray-100 pb-5">
            <span class="text-xs font-extrabold uppercase tracking-widest text-[#1C6521] font-display">
              CORREOS
            </span>
            <div class="space-y-2 pt-1">
              <a href="mailto:ventas@jimaco.com.co" class="flex items-center gap-3 group">
                <div class="w-9 h-9 rounded-full bg-emerald-50 text-[#1C6521] flex items-center justify-center shrink-0 group-hover:bg-emerald-100 transition-colors">
                  <svg class="w-4 h-4 text-[#88D67C]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <span class="font-display font-medium text-sm sm:text-base text-gray-800 group-hover:text-jimaco-orange transition-colors">
                  ventas@jimaco.com.co
                </span>
              </a>
              <a href="mailto:info@jimaco.com.co" class="flex items-center gap-3 group">
                <div class="w-9 h-9 rounded-full bg-emerald-50 text-[#1C6521] flex items-center justify-center shrink-0 group-hover:bg-emerald-100 transition-colors">
                  <svg class="w-4 h-4 text-[#88D67C]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <span class="font-display font-medium text-sm sm:text-base text-gray-800 group-hover:text-jimaco-orange transition-colors">
                  info@jimaco.com.co
                </span>
              </a>
            </div>
          </div>

          <!-- Teléfonos y Líneas de Atención -->
          <div class="space-y-2 border-b border-gray-100 pb-5">
            <span class="text-xs font-extrabold uppercase tracking-widest text-[#1C6521] font-display">
              TELÉFONOS
            </span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
              
              <a href="tel:+576013782933" class="flex items-center gap-3 p-3 rounded-2xl bg-gray-50 hover:bg-emerald-50/60 border border-gray-100 transition-all group">
                <div class="w-8 h-8 rounded-full bg-white shadow-xs flex items-center justify-center text-[#1C6521] shrink-0">
                  <svg class="w-4 h-4 text-[#1C6521]" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                  </svg>
                </div>
                <div>
                  <span class="text-[10px] uppercase font-bold text-gray-400 block font-display">PBX FIJO</span>
                  <span class="font-display font-bold text-xs sm:text-sm text-gray-900 group-hover:text-[#1C6521] transition-colors">+57 601 3782933</span>
                </div>
              </a>

              <a href="https://wa.me/573123503397" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 p-3 rounded-2xl bg-gray-50 hover:bg-emerald-50/60 border border-gray-100 transition-all group">
                <div class="w-8 h-8 rounded-full bg-[#25D366] text-white shadow-xs flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
                  </svg>
                </div>
                <div>
                  <span class="text-[10px] uppercase font-bold text-gray-400 block font-display">WHATSAPP OFICIAL</span>
                  <span class="font-display font-bold text-xs sm:text-sm text-gray-900 group-hover:text-[#1C6521] transition-colors">+57 312 3503397</span>
                </div>
              </a>

              <a href="tel:+573002428521" class="flex items-center gap-3 p-3 rounded-2xl bg-gray-50 hover:bg-emerald-50/60 border border-gray-100 transition-all group">
                <div class="w-8 h-8 rounded-full bg-white shadow-xs flex items-center justify-center text-[#1C6521] shrink-0">
                  <svg class="w-4 h-4 text-[#1C6521]" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                  </svg>
                </div>
                <div>
                  <span class="text-[10px] uppercase font-bold text-gray-400 block font-display">LÍNEA COMERCIAL 1</span>
                  <span class="font-display font-bold text-xs sm:text-sm text-gray-900 group-hover:text-[#1C6521] transition-colors">+57 300 2428521</span>
                </div>
              </a>

              <a href="tel:+573158964700" class="flex items-center gap-3 p-3 rounded-2xl bg-gray-50 hover:bg-emerald-50/60 border border-gray-100 transition-all group">
                <div class="w-8 h-8 rounded-full bg-white shadow-xs flex items-center justify-center text-[#1C6521] shrink-0">
                  <svg class="w-4 h-4 text-[#1C6521]" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                  </svg>
                </div>
                <div>
                  <span class="text-[10px] uppercase font-bold text-gray-400 block font-display">LÍNEA COMERCIAL 2</span>
                  <span class="font-display font-bold text-xs sm:text-sm text-gray-900 group-hover:text-[#1C6521] transition-colors">+57 315 8964700</span>
                </div>
              </a>

            </div>
          </div>

          <!-- Redes Sociales -->
          <div class="space-y-3 pt-2">
            <span class="text-xs font-extrabold uppercase tracking-widest text-[#1C6521] font-display">
              REDES SOCIALES
            </span>
            <div class="flex items-center gap-3">
              <a href="https://instagram.com/jimaco_sas" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-xl bg-gray-100 hover:bg-[#E1306C] hover:text-white text-gray-700 flex items-center justify-center transition-all shadow-xs">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              </a>

              <a href="https://facebook.com/jimaco.colombia" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-xl bg-gray-100 hover:bg-[#1877F2] hover:text-white text-gray-700 flex items-center justify-center transition-all shadow-xs">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.667 5H18V0h-3.808C10.595 0 9 1.582 9 4.615V8z"/></svg>
              </a>

              <a href="https://linkedin.com/company/jimaco-sas" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-xl bg-gray-100 hover:bg-[#0A66C2] hover:text-white text-gray-700 flex items-center justify-center transition-all shadow-xs">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45c-.88 0-1.6.72-1.6 1.6 0 .88.72 1.6 1.6 1.6.89 0 1.61-.72 1.61-1.6 0-.88-.72-1.6-1.61-1.6z"/></svg>
              </a>

              <a href="https://youtube.com/@jimaco_sas" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-xl bg-gray-100 hover:bg-[#FF0000] hover:text-white text-gray-700 flex items-center justify-center transition-all shadow-xs">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              </a>
            </div>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- 3. Dark Green Marquee: Impulsemos un futuro más limpio y sostenible. -->
  <div class="w-full py-5 sm:py-6 bg-[#063A16] border-t border-b border-black/20 overflow-hidden relative select-none">
    <div class="marquee-track-contact flex w-max gap-8 sm:gap-12 items-center">
      {[1, 2, 3, 4, 5, 6, 7, 8].map(() => (
        <div class="flex items-center gap-3 sm:gap-4 text-2xl sm:text-3xl lg:text-4xl font-display tracking-tight whitespace-nowrap">
          <span class="text-white/90 font-bold">Impulsemos</span>
          <span class="text-white/80 font-medium">un futuro</span>
          <span class="text-[#88D67C] font-extrabold italic">más limpio y sostenible.</span>
          <span class="text-[#88D67C]/50 font-bold mx-2">.</span>
        </div>
      ))}
    </div>
  </div>

  <!-- 4. Partner Brands Single Animated Row -->
  <BrandLogosBorderGrid />

</Layout>

<style>
  @keyframes marqueeContact {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .marquee-track-contact {
    animation: marqueeContact 26s linear infinite;
    will-change: transform;
  }

  .marquee-track-contact:hover {
    animation-play-state: paused;
  }
</style>
