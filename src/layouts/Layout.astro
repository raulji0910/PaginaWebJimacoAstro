---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Ferretería Industrial JIMACO — Engranando futuro juntos. Suministros certificados para energía solar, construcción y protección personal en Colombia." 
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@500;600;700;800&family=Karla:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <title>{title} — JIMACO</title>
  </head>
  <body class="bg-[#FDFDFD] text-jimaco-dark font-sans antialiased selection:bg-jimaco-accent selection:text-white flex flex-col min-h-screen">
    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
  
    <!-- Global Media Connection Cleanup (Prevents LiteSpeed TCP Socket Lockups) -->
    <script is:inline>
      window.addEventListener('pagehide', function() {
        var vids = document.querySelectorAll('video');
        for (var i = 0; i < vids.length; i++) {
          vids[i].pause();
          vids[i].removeAttribute('src');
          var sources = vids[i].querySelectorAll('source');
          for (var j = 0; j < sources.length; j++) {
            sources[j].removeAttribute('src');
          }
          vids[i].load();
        }
      });
    </script>
  </body>
</html>
